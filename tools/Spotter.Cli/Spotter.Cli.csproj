<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless runner: exercise discovery, log replay, data loading and quest states without the UI or the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SpotterWindowsTfm)</TargetFramework>
    <RootNamespace>Spotter.Cli</RootNamespace>
    <AssemblyName>spotter-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spotter.Core\Spotter.Core.csproj" />
    <ProjectReference Include="..\..\src\Spotter.Game\Spotter.Game.csproj" />
    <ProjectReference Include="..\..\src\Spotter.Data\Spotter.Data.csproj" />
    <ProjectReference Include="..\..\src\Spotter.Map\Spotter.Map.csproj" />
    <ProjectReference Include="..\..\src\Spotter.Session\Spotter.Session.csproj" />
  </ItemGroup>
</Project>
