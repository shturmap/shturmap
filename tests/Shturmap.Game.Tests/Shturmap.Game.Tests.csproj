<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ShturmapWindowsTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shturmap.Game\Shturmap.Game.csproj" />
  </ItemGroup>

  <!-- The extract list reader's and the stash reader's tests draw their own pictures (SkiaSharp), and also read real
       screenshots where a PC has them: tests\fixtures\ocr, which git ignores (a player's screenshots stay out of the
       repository). The stash folder holds the screenshots, their hand-written truths and the list of trading screens. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <None Include="..\fixtures\ocr\exits-*.png;..\fixtures\ocr\no-list-*.png" LinkBase="fixtures\ocr" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ocr\stash\*.png;..\fixtures\ocr\stash\*.txt" LinkBase="fixtures\ocr\stash" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
