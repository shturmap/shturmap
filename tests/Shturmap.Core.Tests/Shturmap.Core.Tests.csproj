<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shturmap.Core\Shturmap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app's rules that need no window (src\Shturmap.App\Rules). Its project is WinUI and can't be referenced from
       a test, so these files, which use nothing of WinUI, are compiled in here as they are. -->
  <ItemGroup>
    <Compile Include="..\..\src\Shturmap.App\Rules\*.cs" LinkBase="App" />
  </ItemGroup>
</Project>
