<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ShturmapWindowsTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shturmap.Session\Shturmap.Session.csproj" />
  </ItemGroup>

  <!-- The stash desk's reading of real screenshots against the whole catalogue (DeskRealPictureTests): the owner's GEAR-tab
       and stash pictures with their hand-written truths stay in the ignored tests\fixtures\ocr\desk and \stash, the layout
       round's test set (2026-10-25) in \desk\session, the real set of 2026-10-27 (DeskRealSetTests) in
       \real-2026-10-27\desk and \raid. -->
  <ItemGroup>
    <None Include="..\fixtures\ocr\desk\*.png;..\fixtures\ocr\desk\*.txt" LinkBase="fixtures\ocr\desk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ocr\desk\session\*.png;..\fixtures\ocr\desk\session\*.txt" LinkBase="fixtures\ocr\desk\session" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ocr\stash\*.png;..\fixtures\ocr\stash\*.txt" LinkBase="fixtures\ocr\stash" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ocr\real-2026-10-27\desk\*.png;..\fixtures\ocr\real-2026-10-27\desk\*.txt" LinkBase="fixtures\ocr\real-2026-10-27\desk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ocr\real-2026-10-27\raid\*.png;..\fixtures\ocr\real-2026-10-27\raid\*.txt" LinkBase="fixtures\ocr\real-2026-10-27\raid" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
