<Project Sdk="Microsoft.NET.Sdk">
  <!-- Map drawing with SkiaSharp: artwork, camera, overlays. No UI framework, so it can render to a PNG in tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shturmap.Map</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shturmap.Map.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shturmap.Core\Shturmap.Core.csproj" />
    <ProjectReference Include="..\Shturmap.Data\Shturmap.Data.csproj" />
  </ItemGroup>
</Project>
