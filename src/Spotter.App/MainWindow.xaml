<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spotter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spotter.App"
    xmlns:controls="using:Spotter.App.Controls"
    Title="Spotter">

  <Grid Background="{StaticResource GroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Status bar: mode, raid, last fix on the left; the inputs as small status lights and help on the right. -->
    <Grid Padding="16,0,10,0" ColumnSpacing="16" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="SPOTTER" Style="{StaticResource StatusText}" FontWeight="Bold" CharacterSpacing="320" />
        <Rectangle Width="1" Height="16" Fill="{StaticResource LineStrongBrush}" VerticalAlignment="Center" />
        <DropDownButton Content="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="12"
                        Padding="6,2" VerticalAlignment="Center" ToolTipService.ToolTip="Game mode (follows the game's log)">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem Text="PvE" Tag="Pve" Click="OnModeClick" />
              <MenuFlyoutItem Text="PvP" Tag="Pvp" Click="OnModeClick" />
              <MenuFlyoutItem Text="Seasonal" Tag="Seasonal" Click="OnModeClick" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidText), Mode=OneWay}" Style="{StaticResource StatusText}"
                   Foreground="{x:Bind RaidBrush(ViewModel.InRaid), Mode=OneWay}" />
        <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.FixText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.LogsOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.LogsText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.ScreenshotsOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.ScreenshotsText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.DataOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.DataText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <Button x:Name="HelpButton" Width="28" Height="28" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="How Spotter works (F1)">
          <TextBlock Text="?" Style="{StaticResource StatusText}" HorizontalAlignment="Center" />
          <Button.Flyout>
            <Flyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight" Opened="OnHelpOpened" Closed="OnHelpClosed">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                  <Setter Property="MaxWidth" Value="540" />
                  <Setter Property="Padding" Value="18,16" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <StackPanel Width="480" Spacing="8">
                <TextBlock Text="HOW SPOTTER WORKS" Style="{StaticResource TitleText}" CharacterSpacing="80" />
                <TextBlock TextWrapping="Wrap">
                  <Run Text="In a raid, press " /><Run Text="{x:Bind ViewModel.HelpKeys, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" /><Run Text=". The game names each screenshot with your position; Spotter moves your marker, picks the floor and sorts your objectives by distance." />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="The map, the raid and your quest progress follow the game's logs on their own. Nothing needs clicking while you play." />
                <TextBlock TextWrapping="Wrap" Text="Between raids, Spotter suggests where to go next, what you can complete there and what to bring." />
                <TextBlock TextWrapping="Wrap" Text="Point at a quest, in the list or on the map, to see its card and light up everywhere else it appears. Move into the card and point at a key, an item or a quest in it for that one's card. Pin a card to keep it as a small window; in a raid it shows how far each objective is." />
                <TextBlock Style="{StaticResource NoteText}" Text="Quests come from the game's logs alone, so a quest started before your oldest log isn't shown." />

                <TextBlock Style="{StaticResource EyebrowText}" Text="KEYS · WHEN THIS WINDOW HAS FOCUS" />
                <ItemsControl ItemsSource="{x:Bind Keys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:KeyHelp">
                      <Grid ColumnSpacing="12" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{x:Bind Key}" Style="{StaticResource StatusText}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Action}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EyebrowText}" Text="QUEST TYPES" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Legend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LegendItem">
                      <Grid ColumnSpacing="10" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Explanation}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource NoteText}" Margin="0,10,0,0"
                           Text="Spotter only reads your screenshots' names, the game's logs and public tarkov.dev data. It never touches the game. It keeps a study log of raids and how you use it in %LOCALAPPDATA%\Spotter\study; nothing is sent anywhere." />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="384" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: Plan between raids, Raid during one. The state follows the game. -->
      <Grid Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="16,4,16,0">
          <TextBlock Style="{StaticResource EyebrowText}" Text="MAP" Margin="0,14,0,6" />
          <ComboBox HorizontalAlignment="Stretch" FontStretch="SemiCondensed" FontWeight="SemiBold"
                    ItemsSource="{x:Bind ViewModel.MapChoices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}"
                    SelectionChanged="OnMapPicked" />
        </StackPanel>
        <ScrollViewer x:Name="RailScroll" Grid.Row="1" Padding="16,0,16,20" ViewChanged="OnRailScrolled">
          <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.Hint), Mode=OneWay}"
                       Style="{StaticResource NoteText}" Margin="0,16,0,0" />

            <!-- PLAN -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:Caps.Of(ViewModel.LastRaidText), Mode=OneWay}"
                         Visibility="{x:Bind ShownIf(ViewModel.LastRaidText), Mode=OneWay}" Margin="0,18,0,0" />
              <TextBlock Style="{StaticResource EyebrowText}" Text="NEXT RAID" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PlanCard">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12" Margin="0,0,0,6"
                            Background="{x:Bind CardBackground}" BorderBrush="{x:Bind CardBorder}" BorderThickness="1"
                            Tag="{x:Bind NormalizedName}" Click="OnPlanClick">
                      <StackPanel Spacing="3">
                        <Grid>
                          <TextBlock Text="{x:Bind MapTitle}" Style="{StaticResource TitleText}" CharacterSpacing="60" />
                          <TextBlock Text="{x:Bind Rank}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind Summary}" Foreground="{StaticResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="A quest counts as one to complete when all its raid objectives can be done on this map in one raid, and none needs found-in-raid items or more than 3 kills. The others only progress here." />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NoteText}" />
                        <StackPanel Visibility="{x:Bind ExpandedVisibility}">
                          <TextBlock Style="{StaticResource EyebrowText}" Text="COMPLETE" Margin="0,14,0,4" Visibility="{x:Bind FinishVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Finish}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="PROGRESS" Margin="0,14,0,4" Visibility="{x:Bind ProgressVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Progress}" Visibility="{x:Bind ProgressVisibility}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.6" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="BRING" Margin="0,14,0,6" Visibility="{x:Bind RequirementsVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Requirements}" Visibility="{x:Bind RequirementsVisibility}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:RequirementLine">
                                <Grid ColumnSpacing="12" Padding="6,4" Margin="-6,0"
                                      controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Quests="{x:Bind QuestIds}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <controls:Picture ItemId="{x:Bind ItemId}" Glyph="{x:Bind Glyph}" Size="40" />
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind For}" Style="{StaticResource NoteText}" />
                                    <TextBlock Text="{x:Bind Source}" Style="{StaticResource NoteText}" Foreground="{StaticResource AmberBrush}"
                                               Visibility="{x:Bind SourceVisibility}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource EyebrowText}" Text="ANY MAP" Visibility="{x:Bind ShownIfAny(ViewModel.AnyMap), Mode=OneWay}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.AnyMap, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:QuestLine">
                    <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.6" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- RAID -->
            <StackPanel Visibility="{x:Bind ShownIfTrue(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidLine), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource AmberBrush}"
                         TextWrapping="Wrap" Margin="0,18,0,0" />
              <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind ViewModel.ObjectivesHeader, Mode=OneWay}" />
              <ListView ItemsSource="{x:Bind ViewModel.Objectives, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnObjectiveClick"
                        Margin="-12,0" Padding="0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ObjectiveItem">
                    <Grid Padding="6,8" Margin="-6,0" ColumnSpacing="10" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <controls:Picture TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="16" />
                          <TextBlock Text="{x:Bind Quest}" Style="{StaticResource NoteText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Needs}" Visibility="{x:Bind NeedsVisibility}" FontSize="12.5" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Bind Distance}" Style="{StaticResource FigureText}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <TextBlock Style="{StaticResource EyebrowText}" Text="NO FIXED PLACE" Visibility="{x:Bind ShownIfAny(ViewModel.Unplaced), Mode=OneWay}" />
              <ListView ItemsSource="{x:Bind ViewModel.Unplaced, Mode=OneWay}" SelectionMode="None" Margin="-12,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ObjectiveItem">
                    <Grid Padding="6,6" Margin="-6,0" ColumnSpacing="10" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <controls:Picture TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="16" Opacity="0.6" />
                          <TextBlock Text="{x:Bind Quest}" Style="{StaticResource NoteText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Needs}" Visibility="{x:Bind NeedsVisibility}" FontSize="12.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <TextBlock Style="{StaticResource EyebrowText}" Text="EXTRACTS AND TRANSITS" />
              <ListView ItemsSource="{x:Bind ViewModel.Extracts, Mode=OneWay}" SelectionMode="None" Margin="-12,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ExtractItem">
                    <Grid Padding="6,5" Margin="-6,0" ColumnSpacing="10" controls:Linked.Marker="{x:Bind Id}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Kind)}" Style="{StaticResource StatusText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Distance}" Style="{StaticResource FigureText}" Foreground="{StaticResource GreenBrush}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- The map. -->
      <Grid Grid.Column="1">
        <controls:MapView x:Name="Map" />

        <!-- One-line notices, top centre; they go by themselves. -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16" MaxWidth="900" Padding="14,8,6,8"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIfTrue(ViewModel.NoticeOpen), Mode=OneWay}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Width="24" Height="24" Padding="0" Click="OnNoticeClosed" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Dismiss">
              <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
            </Button>
          </Grid>
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="4">
          <!-- Floors, top first. Spotter shows yours (dot) from each screenshot; a pick here holds until the next one. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.Floors, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,0,12"
                        ToolTipService.ToolTip="Floors. Spotter shows yours (dot) from each screenshot; pick another, or use PgUp / PgDn, to look around until your next screenshot.">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FloorChoice">
                <Button Tag="{x:Bind Index}" Click="OnFloorClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,0,0,-1" BorderBrush="{x:Bind Border}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Rectangle Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" Visibility="{x:Bind PlayerVisibility}" />
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource StatusText}" FontSize="11.5" Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ToggleButton Width="36" Height="36" Padding="0" HorizontalAlignment="Right" IsChecked="{x:Bind ViewModel.Following, Mode=TwoWay}"
                        Click="OnFollowClick" ToolTipService.ToolTip="Follow my position (F)">
            <FontIcon Glyph="&#xE81D;" FontSize="15" />
          </ToggleButton>
          <Button Style="{StaticResource MapButton}" Click="OnFitClick" ToolTipService.ToolTip="Show the whole map (0)"><FontIcon Glyph="&#xE9A6;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomInClick" ToolTipService.ToolTip="Zoom in (+)"><FontIcon Glyph="&#xE710;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomOutClick" ToolTipService.ToolTip="Zoom out (−)"><FontIcon Glyph="&#xE738;" FontSize="15" /></Button>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Style="{StaticResource NoteText}" FontSize="11"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,10" />
      </Grid>
    </Grid>
  </Grid>
</Window>
