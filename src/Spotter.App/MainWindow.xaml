<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spotter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spotter.App"
    xmlns:controls="using:Spotter.App.Controls"
    Title="Spotter">

  <Grid Background="{StaticResource GroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Status bar: mode, raid, last fix on the left; inputs and help on the right. -->
    <Grid Padding="16,8" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="SPOTTER" FontWeight="SemiBold" CharacterSpacing="160" VerticalAlignment="Center" Margin="0,0,6,0" />
        <DropDownButton Content="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontFamily="{StaticResource DataFont}" FontSize="12" Padding="10,3">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem Text="PvE" Tag="Pve" Click="OnModeClick" />
              <MenuFlyoutItem Text="PvP" Tag="Pvp" Click="OnModeClick" />
              <MenuFlyoutItem Text="Seasonal" Tag="Seasonal" Click="OnModeClick" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Border Style="{StaticResource Chip}" BorderBrush="{x:Bind RaidBrush(ViewModel.InRaid), Mode=OneWay}">
          <TextBlock Style="{StaticResource ChipText}" Text="{x:Bind ViewModel.RaidText, Mode=OneWay}" Foreground="{x:Bind RaidBrush(ViewModel.InRaid), Mode=OneWay}" />
        </Border>
        <Border Style="{StaticResource Chip}">
          <TextBlock Style="{StaticResource ChipText}" Text="{x:Bind ViewModel.FixText, Mode=OneWay}" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Border Style="{StaticResource Chip}" BorderBrush="{x:Bind OkBrush(ViewModel.LogsOk), Mode=OneWay}">
          <TextBlock Style="{StaticResource ChipText}" Text="{x:Bind ViewModel.LogsText, Mode=OneWay}" Foreground="{x:Bind OkBrush(ViewModel.LogsOk), Mode=OneWay}" />
        </Border>
        <Border Style="{StaticResource Chip}" BorderBrush="{x:Bind OkBrush(ViewModel.ScreenshotsOk), Mode=OneWay}">
          <TextBlock Style="{StaticResource ChipText}" Text="{x:Bind ViewModel.ScreenshotsText, Mode=OneWay}" Foreground="{x:Bind OkBrush(ViewModel.ScreenshotsOk), Mode=OneWay}" />
        </Border>
        <Border Style="{StaticResource Chip}" BorderBrush="{x:Bind OkBrush(ViewModel.DataOk), Mode=OneWay}">
          <TextBlock Style="{StaticResource ChipText}" Text="{x:Bind ViewModel.DataText, Mode=OneWay}" Foreground="{x:Bind OkBrush(ViewModel.DataOk), Mode=OneWay}" />
        </Border>
        <Button x:Name="HelpButton" Padding="8,4" ToolTipService.ToolTip="How Spotter works (F1)">
          <FontIcon Glyph="&#xE897;" FontSize="14" />
          <Button.Flyout>
            <Flyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight" Closed="OnHelpClosed">
              <StackPanel Width="440" Spacing="6">
                <TextBlock Text="How Spotter works" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap">
                  <Run Text="In a raid, press " /><Run Text="{x:Bind ViewModel.HelpKeys, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". The game names each screenshot with your position; Spotter moves your marker, picks the floor and sorts your objectives by distance." />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="The map, the raid and your quest progress follow the game's logs on their own. Nothing needs clicking while you play." />
                <TextBlock TextWrapping="Wrap" Text="Between raids, Spotter suggests where to go next, what you can complete there and what to bring." />
                <TextBlock TextWrapping="Wrap" Text="Point at a quest, in the list or on the map, to see its card and light up everywhere else it appears. Move into the card and point at a key, an item or a quest in it for that one's card. Pin a card to keep it as a small window; in a raid it shows how far each objective is." />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Quests come from the game's logs alone, so a quest started before your oldest log isn't shown." />

                <TextBlock Style="{StaticResource EyebrowText}" Text="KEYS (WHEN THIS WINDOW HAS FOCUS)" />
                <Grid ColumnSpacing="16" RowSpacing="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock FontFamily="{StaticResource DataFont}" Text="F" />
                  <TextBlock Grid.Column="1" Text="Follow my position" />
                  <TextBlock Grid.Row="1" FontFamily="{StaticResource DataFont}" Text="+ / −" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="Zoom in / out (or the mouse wheel)" />
                  <TextBlock Grid.Row="2" FontFamily="{StaticResource DataFont}" Text="0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Show the whole map" />
                  <TextBlock Grid.Row="3" FontFamily="{StaticResource DataFont}" Text="PgUp / PgDn" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Show the floor above / below" />
                  <TextBlock Grid.Row="4" FontFamily="{StaticResource DataFont}" Text="Esc" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Close the card, clear the selected objective" />
                  <TextBlock Grid.Row="5" FontFamily="{StaticResource DataFont}" Text="F1 / ?" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="This help" />
                  <TextBlock Grid.Row="6" FontFamily="{StaticResource DataFont}" Text="Mouse" />
                  <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Text="Drag to move the map, double-click to zoom in, click an objective or a marker to draw a line to it" />
                </Grid>

                <TextBlock Style="{StaticResource EyebrowText}" Text="QUEST TYPES" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Legend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LegendItem">
                      <Grid ColumnSpacing="10" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Explanation}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Spotter only reads your screenshots, the game's logs and public tarkov.dev data. It never touches the game." />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: Plan between raids, Raid during one. The state follows the game. -->
      <Grid Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ComboBox Margin="16,14,16,0" HorizontalAlignment="Stretch" Header="Map"
                  ItemsSource="{x:Bind ViewModel.MapChoices, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}"
                  SelectionChanged="OnMapPicked" />
        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
          <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.Hint), Mode=OneWay}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />

            <!-- PLAN -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.LastRaidText, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.LastRaidText), Mode=OneWay}"
                         Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="12" Margin="0,14,0,0" />
              <TextBlock Style="{StaticResource EyebrowText}" Text="NEXT RAID" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PlanCard">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,0,0,8"
                            Background="{x:Bind CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Tag="{x:Bind NormalizedName}" Click="OnPlanClick">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind MapName}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Summary}" Foreground="{StaticResource AmberBrush}" FontSize="13" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="A quest counts as one to complete when all its raid objectives can be done on this map in one raid, and none needs found-in-raid items or more than 3 kills. The others only progress here." />
                        <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Visibility="{x:Bind ExpandedVisibility}" Spacing="1">
                          <TextBlock Style="{StaticResource EyebrowText}" Text="COMPLETE" Margin="0,10,0,2" Visibility="{x:Bind FinishVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Finish}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="8" Padding="4,3" Margin="-4,0" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="PROGRESS" Margin="0,10,0,2" Visibility="{x:Bind ProgressVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Progress}" Visibility="{x:Bind ProgressVisibility}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="8" Padding="4,3" Margin="-4,0" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.7" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="BRING" Margin="0,10,0,4" Visibility="{x:Bind RequirementsVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Requirements}" Visibility="{x:Bind RequirementsVisibility}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:RequirementLine">
                                <Grid ColumnSpacing="10" Padding="4,3" Margin="-4,0" CornerRadius="4"
                                      controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Quests="{x:Bind QuestIds}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <controls:Picture ItemId="{x:Bind ItemId}" Glyph="{x:Bind Glyph}" Size="34" />
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind For}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource EyebrowText}" Text="ANY MAP" Visibility="{x:Bind ShownIfAny(ViewModel.AnyMap), Mode=OneWay}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.AnyMap, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:QuestLine">
                    <Grid ColumnSpacing="8" Padding="4,3" Margin="-4,0" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.7" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- RAID -->
            <StackPanel Visibility="{x:Bind ShownIfTrue(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.RaidLine, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" FontFamily="{StaticResource DataFont}"
                         FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
              <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind ViewModel.ObjectivesHeader, Mode=OneWay}" />
              <ListView ItemsSource="{x:Bind ViewModel.Objectives, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnObjectiveClick" Margin="-12,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ObjectiveItem">
                    <Grid Padding="6,7" Margin="-6,0" ColumnSpacing="10" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,3,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                          <controls:Picture TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="16" />
                          <TextBlock Text="{x:Bind Quest}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Needs}" Visibility="{x:Bind NeedsVisibility}" Foreground="{StaticResource InkBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Distance}" Foreground="{StaticResource AmberBrush}" FontFamily="{StaticResource DataFont}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind Direction}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="11" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <TextBlock Style="{StaticResource EyebrowText}" Text="NO FIXED PLACE" Visibility="{x:Bind ShownIfAny(ViewModel.Unplaced), Mode=OneWay}" />
              <ListView ItemsSource="{x:Bind ViewModel.Unplaced, Mode=OneWay}" SelectionMode="None" Margin="-12,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ObjectiveItem">
                    <Grid Padding="6,6" Margin="-6,0" ColumnSpacing="10" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                          <controls:Picture TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="16" Opacity="0.7" />
                          <TextBlock Text="{x:Bind Quest}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Needs}" Visibility="{x:Bind NeedsVisibility}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <TextBlock Style="{StaticResource EyebrowText}" Text="EXTRACTS AND TRANSITS" />
              <ListView ItemsSource="{x:Bind ViewModel.Extracts, Mode=OneWay}" SelectionMode="None" Margin="-12,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ExtractItem">
                    <Grid Padding="6,5" Margin="-6,0" ColumnSpacing="10" CornerRadius="4" controls:Linked.Marker="{x:Bind Id}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind Kind}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Distance}" Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource DataFont}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind Direction}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="11" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

      </Grid>

      <!-- The map. -->
      <Grid Grid.Column="1">
        <controls:MapView x:Name="Map" />
        <InfoBar VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}"
                 Severity="Informational" Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" IsClosable="True" CloseButtonClick="OnNoticeClosed" />
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="6">
          <!-- Floors, top first. Spotter shows yours from each screenshot; a pick here holds until the next one. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.Floors, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,0,10"
                        ToolTipService.ToolTip="Floors. Spotter shows yours (dot) from each screenshot; pick another, or use PgUp / PgDn, to look around until your next screenshot.">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FloorChoice">
                <Button Tag="{x:Bind Index}" Click="OnFloorClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="9,3" Margin="0,0,0,3" BorderBrush="{x:Bind Border}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" Visibility="{x:Bind PlayerVisibility}" />
                    <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ToggleButton HorizontalAlignment="Right" IsChecked="{x:Bind ViewModel.Following, Mode=TwoWay}" Click="OnFollowClick" ToolTipService.ToolTip="Follow my position (F)">
            <FontIcon Glyph="&#xE81D;" FontSize="16" />
          </ToggleButton>
          <Button HorizontalAlignment="Right" Click="OnFitClick" ToolTipService.ToolTip="Show the whole map (0)"><FontIcon Glyph="&#xE9A6;" FontSize="16" /></Button>
          <Button HorizontalAlignment="Right" Click="OnZoomInClick" ToolTipService.ToolTip="Zoom in (+)"><FontIcon Glyph="&#xE710;" FontSize="16" /></Button>
          <Button HorizontalAlignment="Right" Click="OnZoomOutClick" ToolTipService.ToolTip="Zoom out (−)"><FontIcon Glyph="&#xE738;" FontSize="16" /></Button>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,10" />
      </Grid>
    </Grid>
  </Grid>
</Window>
