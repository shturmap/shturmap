<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Spotter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Palette: the map's dark green-black ground, the game's amber "active!", map teal and extract green. -->
      <Color x:Key="GroundColor">#0E1413</Color>
      <Color x:Key="RailColor">#141B19</Color>
      <Color x:Key="LineColor">#26302D</Color>
      <Color x:Key="InkColor">#E1E6DE</Color>
      <Color x:Key="MutedColor">#8E9A93</Color>
      <Color x:Key="AmberColor">#E49A3C</Color>
      <Color x:Key="TealColor">#74B8B1</Color>
      <Color x:Key="GreenColor">#6CC38E</Color>
      <Color x:Key="RedColor">#EC7D69</Color>

      <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
      <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
      <SolidColorBrush x:Key="CardBrush" Color="#1B2421" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
      <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
      <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />

      <FontFamily x:Key="DataFont">Cascadia Mono, Consolas</FontFamily>

      <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="0,18,0,6" />
      </Style>

      <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
