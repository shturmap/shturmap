<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spotter.App.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Spotter.App.Controls"
    xmlns:session="using:Spotter.Session">

  <!-- A key or an item: what it is and which of your active quests need it. The quests are cards of their own. -->
  <Border x:Name="Frame" Width="330" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1" CornerRadius="8">
    <Grid>
      <Rectangle x:Name="HoldBar" Height="2" VerticalAlignment="Top" Margin="10,0" Fill="{StaticResource AmberBrush}"
                 RenderTransformOrigin="0,0.5">
        <Rectangle.RenderTransform>
          <ScaleTransform x:Name="HoldScale" ScaleX="0" />
        </Rectangle.RenderTransform>
      </Rectangle>

      <StackPanel Padding="14,12,14,12" Spacing="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Picture ItemId="{x:Bind View.ItemId}" Glyph="{x:Bind Glyph(View.IsKey)}" Size="56" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind View.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind KindText(View.IsKey)}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </Grid>

        <StackPanel Visibility="{x:Bind Shown(View.Uses.Count)}">
          <TextBlock Style="{StaticResource EyebrowText}" Text="NEEDED FOR" Margin="0,2,0,4" />
          <ItemsControl ItemsSource="{x:Bind View.Uses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="session:ItemUse">
                <Grid ColumnSpacing="8" Margin="-4,1" Padding="4,3" CornerRadius="4" controls:Linked.Quest="{x:Bind QuestId}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:KindGlyph Kind="{x:Bind QuestKind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind QuestName}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind How}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Size="20" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="None of your active quests needs it." Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Visibility="{x:Bind Hidden(View.Uses.Count)}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
