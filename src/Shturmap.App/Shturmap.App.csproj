<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ShturmapWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Shturmap.App</RootNamespace>
    <AssemblyName>Shturmap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: a plain folder, no MSIX, no Windows App Runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for publish to include the app's resources.pri and compiled XAML, even without MSIX. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp.Views.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shturmap.Session\Shturmap.Session.csproj" />
  </ItemGroup>

  <!-- Keep the published folder lean. -->
  <ItemGroup>
    <!-- The Windows App SDK brings an ML runtime (onnxruntime, DirectML, ~40 MB) that Shturmap does not use. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" PrivateAssets="all" />
    <!-- The Windows API projection is huge and mostly unused; precompiling it doubles its size for no gain. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <!-- Native packages ship debug symbols (~250 MB) that end users never need. -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>
</Project>
