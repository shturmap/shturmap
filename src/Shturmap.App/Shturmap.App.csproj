<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ShturmapWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Shturmap.App</RootNamespace>
    <AssemblyName>Shturmap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Explorer, shortcuts); the windows load the same file at runtime. brand\build.cs makes it. -->
    <ApplicationIcon>Assets\Shturmap.ico</ApplicationIcon>
    <!-- A developer build (Debug, or engdev.ps1's ShturmapDev=true) carries the dev icon, a cyan plate, so it is never taken for
         the release (docs/DESIGN.md §8, "Developer aids"). -->
    <ApplicationIcon Condition="'$(ShturmapDev)' == 'true' or '$(Configuration)' == 'Debug'">Assets\Shturmap-dev.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: a plain folder, no MSIX, no Windows App Runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for publish to include the app's resources.pri and compiled XAML, even without MSIX. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- WinUI finds the app's resources (its compiled XAML) in resources.pri or in <exe name>.pri. Named after the
         project, they were lost as soon as the exe had another name ("Shturmap-0.1.0-win-x64.exe", or a browser's
         "Shturmap (1).exe"), and the window failed to load (2026-10-03). -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <SelfContained>true</SelfContained>
    <!-- Program.cs starts the exe: Velopack must run before WinUI (docs/DESIGN.md §8, "Distribution"). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp.Views.WinUI" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shturmap.Session\Shturmap.Session.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Shturmap.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Shturmap-dev.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The privacy notice for reports, opened from help and the Report dialog (PRIVACY ↗). -->
    <Content Include="..\..\PRIVACY.md" Link="privacy.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Where reports go: the Sentry DSN, given by eng\release.ps1 (and eng\publish.ps1) from the untracked
       eng\sentry.dsn or SHTURMAP_SENTRY_DSN. Never in the repository; without it the build can't send reports
       (docs/DESIGN.md §8, "Reports"). -->
  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
  </ItemGroup>

  <!-- Keep the published folder lean. -->
  <ItemGroup>
    <!-- The Windows App SDK brings an ML runtime (onnxruntime, DirectML, ~40 MB) that Shturmap does not use. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" PrivateAssets="all" />
    <!-- The Windows API projection is huge and mostly unused; precompiling it doubles its size for no gain. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <!-- The licences a build must carry (docs/DESIGN.md §3): eng\notices.ps1 gathers them before every publish into
       licenses\, published beside the exe; a single exe carries them inside and unpacks them with the app. -->
  <Target Name="PublishNotices" BeforeTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_ShturmapNotices>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)notices</_ShturmapNotices>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\notices.ps1&quot; -Out &quot;$(_ShturmapNotices)&quot;" />
    <ItemGroup>
      <_ShturmapNotice Include="$(_ShturmapNotices)\**\*" />
      <ResolvedFileToPublish Include="@(_ShturmapNotice)" RelativePath="%(_ShturmapNotice.RecursiveDir)%(_ShturmapNotice.Filename)%(_ShturmapNotice.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Native packages ship debug symbols (~250 MB) that end users never need. -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>
</Project>
