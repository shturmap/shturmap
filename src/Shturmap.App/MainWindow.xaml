<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shturmap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shturmap.App"
    xmlns:controls="using:Shturmap.App.Controls"
    xmlns:rules="using:Shturmap.App.Rules"
    Title="Shturmap">

  <Grid Background="{StaticResource GroundBrush}">
    <Grid.Resources>
      <!-- The MAP list's items (Rules.MapList, owner 2026-10-08): a map's item stretches, so what it holds stands at its
           right; the OTHER MAPS heading's item is no choice. -->
      <controls:MapChoiceStyles x:Key="MapChoiceStyles">
        <controls:MapChoiceStyles.Map>
          <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </controls:MapChoiceStyles.Map>
        <controls:MapChoiceStyles.Header>
          <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
          </Style>
        </controls:MapChoiceStyles.Header>
      </controls:MapChoiceStyles>

      <!-- Something to bring, in Plan's cards and the raid card. What the picks need comes first, tinted like the
           picks (linked highlighting), then a hairline and the rest. -->
      <DataTemplate x:Key="RequirementTemplate" x:DataType="local:RequirementLine">
        <Grid ColumnSpacing="12" Padding="6,4" Margin="-6,0"
              controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Items="{x:Bind Alternatives}" controls:Linked.Quests="{x:Bind QuestIds}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="{x:Bind OthersLine}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Picture ItemId="{x:Bind ItemId}" Glyph="{x:Bind Glyph}" Size="40" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind For}" Style="{StaticResource NoteText}" />
            <TextBlock Text="{x:Bind Source}" Style="{StaticResource NoteText}" Foreground="{StaticResource AmberBrush}"
                       Visibility="{x:Bind SourceVisibility}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

      <!-- One part of a line of facts under a map's name ("40 min raid", "Kaban 75%"), with the dot that follows it.
           A boss's part is linked to its spawn zones on the map: pointing at the name lights them, and pointing at
           one of them tints the name. -->
      <DataTemplate x:Key="LinePartTemplate" x:DataType="local:LinePart">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Border Padding="2,0" Margin="-2,0" controls:Linked.Quests="{x:Bind Groups}" controls:Linked.Inline="True">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource NoteText}" />
          </Border>
          <TextBlock Text="·" Style="{StaticResource NoteText}" Visibility="{x:Bind DotVisibility}" />
        </StackPanel>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="LinePartsPanel">
        <controls:WrapRow HorizontalSpacing="5" />
      </ItemsPanelTemplate>

      <!-- A map symbol in help. Its swatch is drawn by the map's own renderer (MapLegend). -->
      <DataTemplate x:Key="MapLegendRowTemplate" x:DataType="local:MapLegendRow">
        <Grid ColumnSpacing="10" Margin="0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="{x:Bind Swatch}" Width="56" Height="34" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <!-- A quest in the raid card: its line as in Plan, then its objectives here with how far and which way.
           The whole block is one quest: pointing at it lights the quest up everywhere, clicking keeps it lit. A
           line in it is one objective: pointing at it marks that objective within the quest (its line tinted once
           more, only its places pulsing on the map), and a gold line that names one key is that key. -->
      <DataTemplate x:Key="RaidQuestTemplate" x:DataType="local:RaidQuest">
        <StackPanel Padding="6,4,6,6" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- COMPLETE and PROGRESS quests alike: a quest that only progresses is still this raid's work (owner,
                 2026-10-03); the section heading says which. -->
            <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
            <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
            <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
            <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
          </Grid>
          <ItemsControl ItemsSource="{x:Bind Objectives}" Margin="26,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ObjectiveItem">
                <Grid ColumnSpacing="10" Padding="6,3" Margin="-6,0" controls:Linked.Objective="{x:Bind ObjectiveId}" controls:Linked.Also="{x:Bind QuestId}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="13" Foreground="{x:Bind TextBrush}" />
                    <Border Visibility="{x:Bind NeedsVisibility}" HorizontalAlignment="Left" Padding="4,0" Margin="-4,0"
                            controls:Linked.Item="{x:Bind KeyId}" controls:Linked.Inline="True">
                      <TextBlock Text="{x:Bind Needs}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                  <!-- What this line gets goes to the trader after the raid: the thing's cell, its count, an arrow and the
                       trader's portrait, before the distance, in the place of the hand-over's own line (owner,
                       2026-10-06, "Hand-over: E"; Handovers). The cell is that item, as a need cell is. -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{x:Bind HandoverVisibility}">
                    <controls:Picture ItemId="{x:Bind ItemId}" Size="20" Visibility="{x:Bind ItemVisibility}"
                                      controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Inline="True" />
                    <controls:HandoverMark TraderId="{x:Bind TraderId}" Count="{x:Bind HandoverCount}" PortraitSize="20" Tip="{x:Bind HandoverTip}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Bind Distance}" Visibility="{x:Bind DistanceVisibility}" Style="{StaticResource FigureText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Visibility="{x:Bind DirectionVisibility}" Style="{StaticResource StatusText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Status bar: mode, raid, last fix on the left; the inputs as small status lights and help on the right. -->
    <Grid x:Name="StatusBar" Padding="16,0,10,0" ColumnSpacing="16" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.Resources>
        <!-- A status word's box is exactly its capitals (Tight), so centring a word centres its capitals: the words, the
             lights, the "?" and the help button's frame share one middle line, at any display scaling (a player's
             report, 2026-10-03; before, each sat on its own text box, which keeps room for accents above the
             capitals). Vertical padding keeps the words easy to point at for their tooltips. -->
        <Style x:Key="StatusBarText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
          <Setter Property="TextLineBounds" Value="Tight" />
        </Style>
      </Grid.Resources>
      <!-- The inputs and the three buttons keep their place at the right; the left takes the rest. In a window too
           narrow for all the bar says, the lights' words go first (the lights stay, each with its tooltip), then the
           last fix, its last word, trims; nothing is pushed out of the window (2026-10-04; StatusBarFit,
           FitStatusBar). -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SHTURMAP" Style="{StaticResource StatusBarText}" FontWeight="Bold" CharacterSpacing="320" />
        <Rectangle Grid.Column="1" Width="1" Height="16" Fill="{StaticResource LineStrongBrush}" VerticalAlignment="Center" />
        <!-- The mode as the game's log says it; no chooser (owner, 2026-10-03). The tooltip says where it comes from.
             Only with no game on this PC is it chosen by hand: there is no log to say it (the no-game fallback). -->
        <TextBlock Grid.Column="2" Text="{x:Bind local:Caps.Of(ViewModel.ModeText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Padding="0,10"
                   ToolTipService.ToolTip="{x:Bind ViewModel.ModeDetail, Mode=OneWay}"
                   Visibility="{x:Bind ShownIfNot(ViewModel.ModeChoosable), Mode=OneWay}" />
        <DropDownButton Grid.Column="2" Content="{x:Bind local:Caps.Of(ViewModel.ModeText), Mode=OneWay}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="12"
                        Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind ShownIfTrue(ViewModel.ModeChoosable), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind local:ViewTexts.StatusModeChooseTip}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem Text="{x:Bind local:ViewTexts.StatusModePve}" Tag="Pve" Click="OnModeChosen" />
              <MenuFlyoutItem Text="{x:Bind local:ViewTexts.StatusModePvp}" Tag="Pvp" Click="OnModeChosen" />
              <MenuFlyoutItem Text="{x:Bind local:ViewTexts.StatusModeSeasonal}" Tag="Seasonal" Click="OnModeChosen" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <!-- Only what the log shows: "NOT IN A RAID" outside a raid, never "in the menus" (RaidStatus; owner, 2026-10-03). -->
        <TextBlock x:Name="RaidWord" Grid.Column="3" Text="{x:Bind local:Caps.Of(ViewModel.RaidText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Padding="0,10"
                   Foreground="{x:Bind RaidBrush(ViewModel.InRaid), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.RaidDetail, Mode=OneWay}" />
        <TextBlock Grid.Column="4" Text="{x:Bind local:Caps.Of(ViewModel.FixText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True" />
      </Grid>
      <StackPanel x:Name="StatusRight" Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <!-- The three lights. Their words are the first thing a narrow window drops (ViewModel.LightWords); a light
             alone still says its word, and what is behind it, in its tooltip. FitStatusBar counts with these
             numbers: a 6 px square, 6 px to its word, 16 px between lights. -->
        <StackPanel x:Name="StatusLights" Orientation="Horizontal" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent" Padding="0,10"
                      ToolTipService.ToolTip="{x:Bind LightTip(ViewModel.LogsText, ViewModel.LogsDetail, ViewModel.LightWords), Mode=OneWay}">
            <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.LogsOk), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.LogsText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Foreground="{StaticResource MutedBrush}"
                       Visibility="{x:Bind ShownIfTrue(ViewModel.LightWords), Mode=OneWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent" Padding="0,10"
                      ToolTipService.ToolTip="{x:Bind LightWord(ViewModel.ScreenshotsText, ViewModel.LightWords), Mode=OneWay}">
            <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.ScreenshotsOk), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.ScreenshotsText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Foreground="{StaticResource MutedBrush}"
                       Visibility="{x:Bind ShownIfTrue(ViewModel.LightWords), Mode=OneWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent" Padding="0,10"
                      ToolTipService.ToolTip="{x:Bind LightTip(ViewModel.DataText, ViewModel.DataDetail, ViewModel.LightWords), Mode=OneWay}">
            <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.DataOk), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.DataText), Mode=OneWay}" Style="{StaticResource StatusBarText}" Foreground="{StaticResource MutedBrush}"
                       Visibility="{x:Bind ShownIfTrue(ViewModel.LightWords), Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
        <!-- A problem or an idea, straight to the Report dialog (owner, 2026-10-03: "there should be a separate
             feedback/bugreport button"). Where the build can't report (no DSN) it is disabled; the tooltip sits on the
             frame around it, since a disabled button shows none. -->
        <Grid Background="Transparent" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind FeedbackTooltip}">
          <Button x:Name="FeedbackButton" Width="28" Height="28" Padding="0" CornerRadius="0" Click="OnFeedbackClick"
                  IsEnabled="{x:Bind ReportingAvailable}" AutomationProperties.Name="{x:Bind local:ViewTexts.FeedbackButtonName}">
            <FontIcon Glyph="&#xE939;" FontSize="13" Foreground="{x:Bind FeedbackIconBrush}" />
          </Button>
        </Grid>
        <Button x:Name="HelpButton" Width="28" Height="28" Padding="0" CornerRadius="0" Margin="-10,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind local:ViewTexts.HelpButtonTip}"
                AutomationProperties.Name="{x:Bind local:ViewTexts.HelpButtonName}">
          <TextBlock Text="?" Style="{StaticResource StatusBarText}" HorizontalAlignment="Center" />
          <Button.Flyout>
            <Flyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight" Opened="OnHelpOpened" Closed="OnHelpClosed">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                  <Setter Property="MaxWidth" Value="540" />
                  <Setter Property="Padding" Value="18,16" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <StackPanel Width="480" Spacing="8">
                <TextBlock Text="{x:Bind local:ViewTexts.HelpTitle}" Style="{StaticResource TitleText}" CharacterSpacing="80" />
                <!-- The tour again, from its start (owner, 2026-10-09; docs/DESIGN.md §4, *The tour*), and the What's New card of
                     this version again (docs/DESIGN.md §4, "Screen anatomy"). SHOW ME beside a paragraph opens the tour at
                     the chapter that shows it. -->
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <HyperlinkButton Padding="0" Click="OnTakeTourClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.HelpTakeTourTip}"
                                   Visibility="{x:Bind ShownIfNot(ViewModel.RaidHoldsBack), Mode=OneWay}">
                    <TextBlock Text="{x:Bind local:ViewTexts.HelpTakeTour}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Click="OnWhatsNewAgainClick" Visibility="{x:Bind ShownIf(ViewModel.WhatsNewHelp), Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.HelpWhatsNewTip}">
                    <TextBlock Text="{x:Bind ViewModel.WhatsNewHelp, Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                </StackPanel>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{x:Bind local:ViewTexts.HelpKeyBefore}" /><Run Text="{x:Bind ViewModel.HelpKeys, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" /><Run Text="{x:Bind local:ViewTexts.HelpKeyAfter}" /><Hyperlink Click="OnTourShowMeClick" AutomationProperties.AutomationId="key" UnderlineStyle="None" Foreground="{StaticResource AmberBrush}"><Run Text="{x:Bind local:ViewTexts.HelpShowMe}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{x:Bind local:ViewTexts.HelpFollows}" /><Hyperlink Click="OnTourShowMeClick" AutomationProperties.AutomationId="follows" UnderlineStyle="None" Foreground="{StaticResource AmberBrush}"><Run Text="{x:Bind local:ViewTexts.HelpShowMe}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{x:Bind local:ViewTexts.HelpNextRaid}" /><Hyperlink Click="OnTourShowMeClick" AutomationProperties.AutomationId="next" UnderlineStyle="None" Foreground="{StaticResource AmberBrush}"><Run Text="{x:Bind local:ViewTexts.HelpShowMe}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{x:Bind local:ViewTexts.HelpExit}" /><Hyperlink Click="OnTourShowMeClick" AutomationProperties.AutomationId="raid" UnderlineStyle="None" Foreground="{StaticResource AmberBrush}"><Run Text="{x:Bind local:ViewTexts.HelpShowMe}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="{x:Bind local:ViewTexts.HelpQuestOrder}" />
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{x:Bind local:ViewTexts.HelpPointAtQuest}" /><Hyperlink Click="OnTourShowMeClick" AutomationProperties.AutomationId="pick" UnderlineStyle="None" Foreground="{StaticResource AmberBrush}"><Run Text="{x:Bind local:ViewTexts.HelpShowMe}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" /></Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="{x:Bind local:ViewTexts.HelpPicks}" />
                <TextBlock TextWrapping="Wrap" Text="{x:Bind local:ViewTexts.HelpTicks}" />
                <TextBlock TextWrapping="Wrap" Text="{x:Bind local:ViewTexts.HelpReplay}" />
                <TextBlock Style="{StaticResource NoteText}" Text="{x:Bind local:ViewTexts.HelpQuestsFromLogs}" />
                <!-- True as long as tarkov.dev leaves them out of its data (docs/UPDATES.md, "Story chapters"; owner, 2026-10-09). -->
                <TextBlock Style="{StaticResource NoteText}" Text="{x:Bind local:ViewTexts.HelpStoryChapters}" />

                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.HelpKeysHeading}" />
                <ItemsControl ItemsSource="{x:Bind Keys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:KeyHelp">
                      <Grid ColumnSpacing="12" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{x:Bind controls:Columns.HelpKeys}" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{x:Bind Key}" Style="{StaticResource StatusText}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Action}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.HelpQuestTypesHeading}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Legend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LegendItem">
                      <Grid ColumnSpacing="10" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Explanation}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LegendHeading" Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.HelpLegendHeading}" />
                <!-- Drawn by the map's own renderer (MapLegend), most important first. Up to twelve of the symbols on
                     the map shown now; the rest of them, and the symbols it doesn't have, wait behind a link (owner,
                     2026-10-04: all of them made help 2,350 px tall; 2026-10-09: Streets listed 26). Filled when help
                     opens (ShowLegend, Rules.LegendFold). -->
                <ItemsControl x:Name="LegendHere" ItemTemplate="{StaticResource MapLegendRowTemplate}" />
                <HyperlinkButton x:Name="LegendMore" Padding="0" Click="OnLegendMoreClick" Visibility="Collapsed">
                  <TextBlock x:Name="LegendMoreText" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                </HyperlinkButton>
                <StackPanel x:Name="LegendRest" Spacing="8" Visibility="Collapsed">
                  <ItemsControl x:Name="LegendRestHere" ItemTemplate="{StaticResource MapLegendRowTemplate}" />
                  <TextBlock x:Name="LegendElsewhereHeading" Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.HelpLegendElsewhereHeading}" />
                  <ItemsControl x:Name="LegendElsewhere" ItemTemplate="{StaticResource MapLegendRowTemplate}" />
                </StackPanel>
                <TextBlock Style="{StaticResource NoteText}" Margin="0,10,0,0"
                           Text="{x:Bind local:ViewTexts.HelpPrivacy}" />
                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.HelpAndFeedback}" Margin="0,8,0,0" />
                <!-- Reports go through the feedback button at the top right (owner, 2026-10-03: "there should be a separate
                     feedback/bugreport button"); help keeps the diagnostics to paste elsewhere. -->
                <TextBlock TextWrapping="Wrap" Text="{x:Bind FeedbackPointer}" />
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,4,0,0">
                  <HyperlinkButton Padding="0" Click="OnCopyDiagnosticsClick"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.HelpCopyDiagnosticsTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.HelpCopyDiagnostics}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                </StackPanel>
                <TextBlock Style="{StaticResource NoteText}" Visibility="{x:Bind NotConfiguredVisibility}"
                           Text="{x:Bind local:ViewTexts.HelpReportingNotSetUp}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Settings and the app's data, apart from help (owner, 2026-10-03: "It's not clear that the settings are with the
             questionmark on the top right … a settings button next to it"). Same frame as "?", 6 px from it. -->
        <Button x:Name="SettingsButton" Width="28" Height="28" Padding="0" CornerRadius="0" Margin="-10,0,0,0" VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsButtonTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.SettingsButtonName}">
          <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{StaticResource InkBrush}" />
          <Button.Flyout>
            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opened="OnSettingsOpened" Closed="OnSettingsClosed">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                  <Setter Property="MaxWidth" Value="540" />
                  <Setter Property="Padding" Value="18,16" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <StackPanel Width="480" Spacing="8">
                <TextBlock Text="{x:Bind local:ViewTexts.SettingsTitle}" Style="{StaticResource TitleText}" CharacterSpacing="80" />
                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.SettingsPreferences}" />
                <!-- The study log's switch: developer builds only (owner, 2026-10-03: "The study log should only be part
                     of the dev version and not be in the release version"). Filled in code under DEVTOOLS
                     (AddStudySwitch), so a release has none of it; empty and collapsed there. -->
                <StackPanel x:Name="StudySwitch" Spacing="8" Visibility="Collapsed" />
                <!-- One language for everything, chosen here or automatically (owner, 2026-10-10; docs/DESIGN.md §8, "The
                     app's own language"): AUTOMATIC, then each language offered in its own name (MainWindow.Language,
                     ShowLanguage); a choice applies at once. Under it, what Automatic comes to and why. -->
                <Grid ColumnSpacing="14" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind local:ViewTexts.SettingsLanguage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}" VerticalAlignment="Center"
                                IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:WrapRow HorizontalSpacing="14" VerticalSpacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:LanguageOption">
                        <HyperlinkButton Padding="0" Tag="{x:Bind Setting}" Click="OnLanguageClick" ToolTipService.ToolTip="{x:Bind Tip}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                       Visibility="{x:Bind ChosenVisibility}" />
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{x:Bind LabelBrush}" />
                          </StackPanel>
                        </HyperlinkButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <TextBlock Style="{StaticResource NoteText}" TextWrapping="Wrap" Text="{x:Bind ViewModel.LanguageNote, Mode=OneWay}" />
                <!-- Position screenshots deleted a few seconds after reading (owner, 2026-10-04: "a mode that auto-deletes
                     screenshots after a couple of seconds grace period"). Off unless ticked: it is the one thing Shturmap
                     changes outside its own folders (docs/DESIGN.md §2). -->
                <ToggleButton IsChecked="{x:Bind ViewModel.DeleteScreenshots, Mode=OneWay}" Click="OnDeleteScreenshotsClick" Margin="0,6,0,0"
                              Style="{StaticResource TickToggle}" AutomationProperties.Name="{x:Bind local:ViewTexts.SettingsDeleteScreenshots}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="13" Height="13" BorderThickness="1" BorderBrush="{StaticResource AmberBrush}" VerticalAlignment="Center"
                            Background="{x:Bind StudyBoxBrush(ViewModel.DeleteScreenshots), Mode=OneWay}">
                      <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="{StaticResource GroundBrush}"
                                Visibility="{x:Bind ShownIfTrue(ViewModel.DeleteScreenshots), Mode=OneWay}" />
                    </Border>
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsDeleteScreenshots}" FontWeight="SemiBold" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock Style="{StaticResource NoteText}" Margin="22,0,0,0" TextWrapping="Wrap" Text="{x:Bind DeleteScreenshotsNote}" />
                <!-- The game's extract list read from a screenshot that shows it (owner, 2026-10-05). The one case where
                     a screenshot's picture is opened, so it can be unticked, and its note says what is looked at
                     (docs/DESIGN.md §2). -->
                <ToggleButton IsChecked="{x:Bind ViewModel.ReadExits, Mode=OneWay}" Click="OnReadExitsClick" Margin="0,8,0,0"
                              Style="{StaticResource TickToggle}" AutomationProperties.Name="{x:Bind local:ViewTexts.SettingsReadExits}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="13" Height="13" BorderThickness="1" BorderBrush="{StaticResource AmberBrush}" VerticalAlignment="Center"
                            Background="{x:Bind StudyBoxBrush(ViewModel.ReadExits), Mode=OneWay}">
                      <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="{StaticResource GroundBrush}"
                                Visibility="{x:Bind ShownIfTrue(ViewModel.ReadExits), Mode=OneWay}" />
                    </Border>
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsReadExits}" FontWeight="SemiBold" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock Style="{StaticResource NoteText}" Margin="22,0,0,0" TextWrapping="Wrap" Text="{x:Bind ReadExitsNote}" />
                <!-- Crash reports go only as the player says here (owner, 2026-10-03: default "Ask after a crash";
                     docs/DESIGN.md §8, "Reports"). -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                  <TextBlock Text="{x:Bind local:ViewTexts.SettingsCrashReports}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <HyperlinkButton Padding="0" Tag="Ask" Click="OnCrashModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsCrashAskTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfMode(ViewModel.CrashMode, 'Ask'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsCrashAsk}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind CrashModeBrush(ViewModel.CrashMode, 'Ask'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Tag="Always" Click="OnCrashModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsCrashAlwaysTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfMode(ViewModel.CrashMode, 'Always'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsCrashAlways}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind CrashModeBrush(ViewModel.CrashMode, 'Always'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Tag="Never" Click="OnCrashModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsCrashNeverTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfMode(ViewModel.CrashMode, 'Never'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsCrashNever}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind CrashModeBrush(ViewModel.CrashMode, 'Never'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                </StackPanel>
                <TextBlock Style="{StaticResource NoteText}" TextWrapping="Wrap"
                           Text="{x:Bind local:ViewTexts.SettingsCrashNote}" />
                <!-- New versions from GitHub Releases, as the player says here (owner, 2026-10-03: default Automatic;
                     docs/DESIGN.md §8, "Distribution"). -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0" Visibility="{x:Bind ShownIfTrue(ViewModel.UpdatesAvailable), Mode=OneWay}">
                  <TextBlock Text="{x:Bind local:ViewTexts.SettingsUpdates}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <HyperlinkButton Padding="0" Tag="Automatic" Click="OnUpdateModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsUpdatesAutomaticTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfUpdateMode(ViewModel.UpdateMode, 'Automatic'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUpdatesAutomatic}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind UpdateModeBrush(ViewModel.UpdateMode, 'Automatic'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Tag="TellOnly" Click="OnUpdateModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsUpdatesTellOnlyTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfUpdateMode(ViewModel.UpdateMode, 'TellOnly'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUpdatesTellOnly}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind UpdateModeBrush(ViewModel.UpdateMode, 'TellOnly'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Tag="Off" Click="OnUpdateModeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsUpdatesOffTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ShownIfUpdateMode(ViewModel.UpdateMode, 'Off'), Mode=OneWay}" />
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUpdatesOff}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{x:Bind UpdateModeBrush(ViewModel.UpdateMode, 'Off'), Mode=OneWay}" />
                    </StackPanel>
                  </HyperlinkButton>
                </StackPanel>
                <TextBlock Style="{StaticResource NoteText}" TextWrapping="Wrap" Visibility="{x:Bind ShownIfTrue(ViewModel.UpdatesAvailable), Mode=OneWay}"
                           Text="{x:Bind local:ViewTexts.SettingsUpdatesNote}" />
                <TextBlock Style="{StaticResource NoteText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{x:Bind ShownIfNot(ViewModel.UpdatesAvailable), Mode=OneWay}"
                           Text="{x:Bind ViewModel.UpdatesNote, Mode=OneWay}" />
                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.SettingsAppAndData}" Margin="0,8,0,0" />
                <!-- Where the game is and where that comes from, and the same choice the no-game line offers, with the way
                     back from it (docs/DESIGN.md, "No game on this PC"; owner, 2026-10-04). The line wraps: the source
                     comes after the path and must not be cut off. -->
                <TextBlock Text="{x:Bind ViewModel.GameFolderText, Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="18" Visibility="{x:Bind ShownIfTrue(ViewModel.GameFolderChangeable), Mode=OneWay}">
                  <HyperlinkButton Padding="0" Click="OnChooseGameFolderClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsChooseGameFolderTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsChooseGameFolder}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Click="OnFindGameAutomaticallyClick" Visibility="{x:Bind ShownIfTrue(ViewModel.FindGameAutomatically), Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsFindGameTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsFindGame}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                </StackPanel>
                <!-- A chosen folder while another install has newer game logs: said quietly, never switched by itself. -->
                <TextBlock Style="{StaticResource NoteText}" Visibility="{x:Bind ShownIf(ViewModel.NewerGameLogs), Mode=OneWay}">
                  <Run Text="{x:Bind ViewModel.NewerGameLogs, Mode=OneWay}" /><Run Text=" · " /><Hyperlink Click="OnFindGameAutomaticallyLinkClick" Foreground="{StaticResource AmberBrush}" UnderlineStyle="None"><Run Text="{x:Bind local:ViewTexts.SettingsFindGame}" /></Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,2,0,0">
                  <HyperlinkButton Padding="0" Click="OnLogFolderClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsLogFolderTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsLogFolder}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Click="OnPrivacyClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsPrivacyTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsPrivacy}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                  <!-- The licences of the code a build carries (eng\notices.ps1), installed with the app. -->
                  <HyperlinkButton Padding="0" Click="OnLicencesClick" Visibility="{x:Bind LicencesVisibility}"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsLicencesTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.SettingsLicences}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                  </HyperlinkButton>
                </StackPanel>
                <!-- Removing Shturmap from here as well as from Windows' Settings, with the data only on a tick
                     (owner, 2026-10-03; docs/DESIGN.md §8, "Distribution"). Installed builds only. -->
                <HyperlinkButton Padding="0" Margin="0,2,0,0" Click="OnUninstallClick" Visibility="{x:Bind UninstallVisibility}"
                                 ToolTipService.ToolTip="{x:Bind local:ViewTexts.SettingsUninstallTip}">
                  <TextBlock Text="{x:Bind local:ViewTexts.SettingsUninstall}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </HyperlinkButton>
                <StackPanel Spacing="6" Margin="0,4,0,0" Padding="12,10" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}"
                            Visibility="{x:Bind ShownIfTrue(ViewModel.UninstallAsking), Mode=OneWay}">
                  <TextBlock Text="{x:Bind local:ViewTexts.SettingsUninstallQuestion}" FontWeight="SemiBold" />
                  <ToggleButton IsChecked="{x:Bind ViewModel.UninstallDeleteData, Mode=OneWay}" Click="OnUninstallDataClick"
                                Style="{StaticResource TickToggle}" AutomationProperties.Name="{x:Bind local:ViewTexts.SettingsUninstallDeleteData}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <Border Width="13" Height="13" BorderThickness="1" BorderBrush="{StaticResource AmberBrush}" VerticalAlignment="Center"
                              Background="{x:Bind StudyBoxBrush(ViewModel.UninstallDeleteData), Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="{StaticResource GroundBrush}"
                                  Visibility="{x:Bind ShownIfTrue(ViewModel.UninstallDeleteData), Mode=OneWay}" />
                      </Border>
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUninstallDeleteData}" />
                    </StackPanel>
                  </ToggleButton>
                  <TextBlock Style="{StaticResource NoteText}" Margin="22,0,0,0" TextWrapping="Wrap" Text="{x:Bind UninstallDataText}" />
                  <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,4,0,0">
                    <HyperlinkButton Padding="0" Click="OnUninstallConfirmClick">
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUninstallConfirm}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="0" Click="OnUninstallCancelClick">
                      <TextBlock Text="{x:Bind local:ViewTexts.SettingsUninstallCancel}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                    </HyperlinkButton>
                  </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource NoteText}" Margin="0,8,0,0" Text="{x:Bind VersionText}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="384" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: Plan between raids, Raid during one. The state follows the game. -->
      <Grid x:Name="Rail" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="16,4,16,0">
          <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RailMapHeading}" Margin="0,14,0,6" />
          <!-- The maps with your quests first, in Plan's order with what each holds, then OTHER MAPS (owner, 2026-10-08:
               "A"; Rules.MapList). The closed list shows the map on screen with its counts too. -->
          <ComboBox x:Name="MapPicker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontStretch="SemiCondensed" FontWeight="SemiBold"
                    ItemsSource="{x:Bind ViewModel.MapChoices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}"
                    ItemContainerStyleSelector="{StaticResource MapChoiceStyles}"
                    SelectionChanged="OnMapPicked">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="rules:MapChoice">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource UiFont}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="14"
                             TextTrimming="CharacterEllipsis" Visibility="{x:Bind local:MapChoiceView.ForMap(IsHeader)}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Count}" FontFamily="{StaticResource UiFont}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="12.5"
                             Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MapChoiceView.ForMap(IsHeader)}" />
                  <!-- OTHER MAPS: a hairline, then the heading in the eyebrow style. -->
                  <StackPanel Grid.ColumnSpan="2" Visibility="{x:Bind local:MapChoiceView.ForHeader(IsHeader)}">
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,2,0,8" />
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EyebrowText}" Margin="0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <!-- RAID, the card's head: the map's name, the side and the raid's time stay at the top of the rail, and the rest
             of the card scrolls under them (owner, 2026-10-08: "the remaining time is crucial information and when
             scrolling down in the quest window it gets pushed outside of view. It should always stay on top"). The
             card is drawn in two parts that meet without a seam: this head, open at its foot, and the body below,
             open at its top. -->
        <StackPanel Grid.Row="1" Margin="16,0,16,0" Visibility="{x:Bind ShownIfTrue(ViewModel.InRaid), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Visibility="{x:Bind HintInRaid(ViewModel.Hint, ViewModel.InRaid), Mode=OneWay}"
                     Style="{StaticResource NoteText}" Margin="0,16,0,0" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RaidHeading}" Margin="0,18,0,6" />
          <Border x:Name="RaidHead" Padding="14,12,14,6" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1,1,1,0">
            <StackPanel Spacing="3">
              <Grid>
                <TextBlock Text="{x:Bind ViewModel.RaidTitle, Mode=OneWay}" Style="{StaticResource TitleText}" CharacterSpacing="60" />
                <TextBlock Text="{x:Bind ViewModel.RaidSide, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                           Visibility="{x:Bind ShownIfNot(ViewModel.SideSwitchable), Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind local:ViewTexts.RaidSideTip}" />
                <!-- A raid hosted on your own machine (PvE can be) looks the same in the log for a PMC and a
                     Scav: then the tag is a switch. -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" Click="OnSideClick"
                        Visibility="{x:Bind ShownIfTrue(ViewModel.SideSwitchable), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind local:ViewTexts.RaidSideSwitchTip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Bind ViewModel.RaidSide, Mode=OneWay}" Style="{StaticResource StatusText}" />
                    <FontIcon Glyph="&#xE8AB;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                  </StackPanel>
                </Button>
              </Grid>
              <!-- How long the raid still runs: what one looks for in a raid, so it is the card's largest figure,
                   right under the map's name, over a rule of the raid's length (owner, 2026-10-04: "This is crucial
                   information"; 2026-10-05: "should be more visible ... a prominent item in the UI"). It changes once
                   a minute, without motion (Controls.RaidClock, Rules.RaidTime). -->
              <controls:RaidClock Reading="{x:Bind ViewModel.RaidClock, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- The rail's typeface and ink are set here: the app's implicit TextBlock style doesn't reach text inside the
             list templates below, which fell back to Segoe UI and white (the raid card's quest names and objective
             lines, the extract rows, BRING in a raid), while Plan's card had the app's own through its button. -->
        <ScrollViewer x:Name="RailScroll" Grid.Row="2" Padding="16,0,16,20" ViewChanged="OnRailScrolled"
                      FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}">
          <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Visibility="{x:Bind HintOutsideRaid(ViewModel.Hint, ViewModel.InRaid), Mode=OneWay}"
                       Style="{StaticResource NoteText}" Margin="0,16,0,0" />

            <!-- PLAN -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.InRaid), Mode=OneWay}">
              <!-- A new version: one quiet line, between raids only; it restarts only on a click (owner, 2026-10-03;
                   docs/DESIGN.md §8, "Distribution"). -->
              <StackPanel Margin="0,18,0,0" Spacing="2" Visibility="{x:Bind ShownIf(ViewModel.UpdateLine), Mode=OneWay}">
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap"
                           Text="{x:Bind local:Caps.Of(ViewModel.UpdateLine), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <HyperlinkButton Padding="0" Click="OnUpdateDownloadClick" Visibility="{x:Bind ShownIfTrue(ViewModel.UpdateOffersDownload), Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.UpdateDownloadTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.UpdateDownload}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                  </HyperlinkButton>
                  <HyperlinkButton Padding="0" Click="OnUpdateRestartClick" Visibility="{x:Bind ShownIfTrue(ViewModel.UpdateOffersRestart), Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind local:ViewTexts.UpdateRestartTip}">
                    <TextBlock Text="{x:Bind local:ViewTexts.UpdateRestart}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                  </HyperlinkButton>
                </StackPanel>
              </StackPanel>
              <!-- What's New (owner, 2026-10-07; docs/DESIGN.md §4, "Screen anatomy"): after an update, until closed or the
                   first raid is over. Pointing at a line previews it on the map, as pointing at a map's row does. -->
              <Grid Margin="0,18,0,0" Visibility="{x:Bind ShownIfTrue(ViewModel.WhatsNewShown), Mode=OneWay}">
              <Border Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.WhatsNewBlocks, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:WhatsNewBlock">
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                          <TextBlock Style="{StaticResource EyebrowText}" Margin="0" Foreground="{StaticResource AmberBrush}" Text="{x:Bind Heading}" />
                          <ItemsControl ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:WhatsNewRow">
                                <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" Background="Transparent" Tag="{x:Bind Key}"
                                      PointerEntered="OnWhatsNewPointerEntered" PointerExited="OnWhatsNewPointerExited" Tapped="OnWhatsNewTapped">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Image Source="{x:Bind Swatch}" Width="56" Height="34" VerticalAlignment="Top" Visibility="{x:Bind SwatchVisibility}" />
                                  <!-- The raid card's clock, small: its figure over its rule. -->
                                  <StackPanel Width="56" Height="34" VerticalAlignment="Top" Visibility="{x:Bind ClockVisibility}" Padding="2,2,2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                      <TextBlock Text="13" FontSize="17" FontWeight="SemiBold" FontStretch="SemiCondensed" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                      <TextBlock Text="{x:Bind local:ViewTexts.WhatsNewClockMinutes}" Style="{StaticResource StatusText}" FontSize="8" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <Grid Height="10" Margin="0,5,0,0">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Rectangle Height="2.5" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{StaticResource LineStrongBrush}" />
                                      <Rectangle Grid.Column="1" Height="2.5" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{StaticResource InkBrush}" />
                                      <Rectangle Grid.Column="1" Width="1.5" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource InkBrush}" />
                                    </Grid>
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource NoteText}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{x:Bind local:ViewTexts.WhatsNewPointAt}" Style="{StaticResource NoteText}" Margin="0,-14,0,0" />
                </StackPanel>
              </Border>
              <!-- The card's close, in its corner as on a notice. -->
              <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Padding="0" Margin="0,8,8,0"
                      Click="OnWhatsNewClosed" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{x:Bind local:ViewTexts.WhatsNewCloseTip}"
                      AutomationProperties.Name="{x:Bind local:ViewTexts.WhatsNewCloseName}">
                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
              </Button>
              </Grid>
              <!-- The last raid, and its replay until the next raid loads (owner, 2026-10-07: "Replay link: ii"). -->
              <Grid Margin="0,18,0,0" Visibility="{x:Bind ShownIf(ViewModel.LastRaidText), Mode=OneWay}">
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0" Text="{x:Bind local:Caps.Of(ViewModel.LastRaidText), Mode=OneWay}" />
                <HyperlinkButton Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnReplayClick"
                                 Visibility="{x:Bind ShownIfTrue(ViewModel.ReplayOffered), Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind local:ViewTexts.PlanReplayTip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind local:ViewTexts.PlanReplay}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                  </StackPanel>
                </HyperlinkButton>
              </Grid>
              <!-- No game on this PC, or it hasn't run yet: said where the Plan card would be, for as long as it lasts
                   (owner, 2026-10-03: the no-game fallback; GameStateLine). -->
              <StackPanel Margin="0,18,0,0" Spacing="4" Visibility="{x:Bind ShownIf(ViewModel.GameLine), Mode=OneWay}">
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap"
                           Text="{x:Bind local:Caps.Of(ViewModel.GameLine), Mode=OneWay}" />
                <HyperlinkButton Padding="0" Click="OnChooseGameFolderClick" Visibility="{x:Bind ShownIfTrue(ViewModel.GameFolderChoosable), Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind local:ViewTexts.PlanChooseGameFolderTip}">
                  <TextBlock Text="{x:Bind local:ViewTexts.PlanChooseGameFolder}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                </HyperlinkButton>
                <TextBlock Text="{x:Bind ViewModel.GameNote, Mode=OneWay}" Style="{StaticResource NoteText}" TextWrapping="Wrap" />
              </StackPanel>
              <!-- NEXT RAID, and while quests are picked, the one deliberate way to drop them all (Esc never does). -->
              <Grid Visibility="{x:Bind ShownIfNot(ViewModel.NoGameLogs), Mode=OneWay}">
                <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.PlanNextRaid}" />
                <HyperlinkButton Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnClearPicksClick"
                                 Visibility="{x:Bind ShownIfTrue(ViewModel.HasPicks), Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind local:ViewTexts.PlanClearPicksTip}">
                  <TextBlock Text="{x:Bind local:ViewTexts.PlanClearPicks}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </HyperlinkButton>
              </Grid>
              <!-- The suggested maps as a short list, best first, always in view (review of 2026-10-04, H4: the open card
                   is some 840 px tall and pushed the other maps' cards under the fold). The open map's row is marked;
                   pointing at a row previews that map, a click shows it and opens its card below. The rows are the
                   only thing that switches the map. One suggested map that is on screen needs no list (PlanList).
                   Every row is the same, the open map's too: a click on a glyph holds its quest's card and, the row
                   being a button, shows its map, and what was clicked must still be there afterwards (owner,
                   2026-10-04: "all the icons disappear ... This is a cognitive dissonance"). So no row changes
                   height when the map changes, and nothing moves under the pointer. -->
              <ItemsControl x:Name="PlanRows" ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}" Visibility="{x:Bind ShownIfTrue(ViewModel.PlanListShown), Mode=OneWay}" Margin="0,0,0,7">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PlanCard">
                    <!-- A map on screen that none of your quests is on has its card below and no row (PlanCard.CardOnly). -->
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,-1"
                            Visibility="{x:Bind RowVisibility}"
                            Background="{x:Bind CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Tag="{x:Bind NormalizedName}" Click="OnPlanClick" AutomationProperties.Name="{x:Bind MapName}"
                            PointerEntered="OnPlanPointerEntered" PointerExited="OnPlanPointerExited">
                      <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.RowSpan="2" Fill="{StaticResource AmberBrush}" Visibility="{x:Bind ExpandedVisibility}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind MapTitle}" Style="{StaticResource TitleText}" FontSize="14" CharacterSpacing="60"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,7" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ShortSummary}" Foreground="{StaticResource AmberBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <!-- Enough to compare without opening it (the study log: ten card clicks in 4.5 minutes to compare
                             maps). One glyph per quest, the picks first in cyan, then those to complete, a hairline, those
                             to progress; then what to bring. Each glyph is its quest for the linked highlight, each cell
                             its item. -->
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,-2,12,8" ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <!-- The picks first, each in its pick's colour, then a hairline (owner, 2026-10-03 and 2026-10-04). -->
                            <ItemsControl ItemsSource="{x:Bind Picked}" Visibility="{x:Bind FoldedPicksVisibility}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{x:Bind PickBrush}" ToolTipService.ToolTip="{x:Bind Name}"
                                                      controls:Linked.Quest="{x:Bind QuestId}" controls:Linked.Inline="True" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Height="12" Margin="3,0" VerticalAlignment="Center" Fill="{StaticResource LineStrongBrush}"
                                       Visibility="{x:Bind PickDividerVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Finish}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" ToolTipService.ToolTip="{x:Bind Name}"
                                                      controls:Linked.Quest="{x:Bind QuestId}" controls:Linked.Inline="True" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Quests to complete, a hairline, then quests to progress: all gold, none dimmed (owner,
                                 2026-10-03). -->
                            <Rectangle Width="1" Height="12" Margin="3,0" VerticalAlignment="Center" Fill="{StaticResource LineStrongBrush}"
                                       Visibility="{x:Bind GlyphDividerVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Progress}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" ToolTipService.ToolTip="{x:Bind Name}"
                                                      controls:Linked.Quest="{x:Bind QuestId}" controls:Linked.Inline="True" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <controls:NeedsStrip Grid.Column="1" Needs="{x:Bind Needs}" Shown="5" />
                        </Grid>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}" Visibility="{x:Bind ShownIfNot(ViewModel.NoGameLogs), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PlanCard">
                    <!-- Only the open map's card: the others are rows in the list above. No button: a click in it is a
                         click on the quest's row or the pen under the pointer, never also a change of map (it was one
                         button until 2026-10-04, "two clicks, two meanings"). Resting on it still previews its map
                         when another one is on screen. -->
                    <Border Padding="14,12" Margin="0,0,0,6" Visibility="{x:Bind ExpandedVisibility}"
                            Background="{x:Bind CardBackground}" BorderBrush="{x:Bind CardBorder}" BorderThickness="1"
                            Tag="{x:Bind NormalizedName}"
                            PointerEntered="OnPlanPointerEntered" PointerExited="OnPlanPointerExited">
                      <!-- Text in a data template takes its face and colour from the control around it, as it did from the
                           button this card was (the implicit TextBlock style doesn't reach in here). -->
                      <ContentControl FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}" IsTabStop="False"
                                      HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{x:Bind MapTitle}" Style="{StaticResource TitleText}" CharacterSpacing="60" />
                          <!-- Amber counts, or, muted, that none of your quests is on the map on screen. -->
                          <TextBlock Text="{x:Bind Summary}" Foreground="{x:Bind SummaryBrush}" FontSize="14" TextWrapping="Wrap"
                                     ToolTipService.ToolTip="{x:Bind local:ViewTexts.CardSummaryTip}" />
                          <ItemsControl ItemsSource="{x:Bind DetailParts}" ItemTemplate="{StaticResource LinePartTemplate}"
                                        ItemsPanel="{StaticResource LinePartsPanel}" IsTabStop="False" AutomationProperties.Name="{x:Bind Detail}" />
                          <StackPanel Visibility="{x:Bind ExpandedVisibility}">
                            <!-- PICKED: the quests picked for the coming raid, first, in a group of their own; a pick that
                                 only progresses here says why, as in PROGRESS (owner, 2026-10-03). -->
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardPicked}" Margin="0,14,0,4"
                                       Visibility="{x:Bind PicksVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Picked}" Visibility="{x:Bind PicksVisibility}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                      <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                      <TextBlock Text="{x:Bind Synopsis}" Visibility="{x:Bind SynopsisVisibility}" Style="{StaticResource NoteText}"
                                                 MaxLines="2" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True" />
                                      <TextBlock Text="{x:Bind local:Caps.Of(Note)}" Visibility="{x:Bind NoteVisibility}" Style="{StaticResource StatusText}"
                                                 FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                 TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
                                    <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                                    <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardComplete}" Margin="0,14,0,4" Visibility="{x:Bind FinishVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Finish}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="{x:Bind GroupLine}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                                    <!-- The name, then what the quest asks here in a few words (QuestSynopsis), at most two lines. -->
                                    <StackPanel Grid.Column="1" Spacing="1">
                                      <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                      <TextBlock Text="{x:Bind Synopsis}" Visibility="{x:Bind SynopsisVisibility}" Style="{StaticResource NoteText}"
                                                 MaxLines="2" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True" />
                                    </StackPanel>
                                    <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
                                    <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                                    <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardProgress}" Margin="0,14,0,4" Visibility="{x:Bind ProgressVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Progress}" Visibility="{x:Bind ProgressVisibility}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="{x:Bind GroupLine}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- As strong as a COMPLETE row; instead of dimming, a short note says why it only
                                         progresses here (Planning.ProgressNote; owner, 2026-10-03). -->
                                    <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                      <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                      <TextBlock Text="{x:Bind Synopsis}" Visibility="{x:Bind SynopsisVisibility}" Style="{StaticResource NoteText}"
                                                 MaxLines="2" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True" />
                                      <TextBlock Text="{x:Bind local:Caps.Of(Note)}" Visibility="{x:Bind NoteVisibility}" Style="{StaticResource StatusText}"
                                                 FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                 TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
                                    <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                                    <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardBring}" Margin="0,14,0,6" Visibility="{x:Bind RequirementsVisibility}" />
                            <ItemsControl ItemsSource="{x:Bind Requirements}" Visibility="{x:Bind RequirementsVisibility}"
                                          ItemTemplate="{StaticResource RequirementTemplate}" />
                          </StackPanel>
                        </StackPanel>
                      </ContentControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- RAID: the map's Plan card, live. The same header and COMPLETE / PROGRESS / BRING; each quest carries its
                 objectives here, nearest first, and the quests are ordered by their nearest objective. The card's head
                 (name, side, the raid's time) stands above, outside what scrolls; this is the rest of it, open at its top
                 (the gap under the clock is the head's, so its rule's ticks keep clear of the edge it gets when scrolled). -->
            <StackPanel Visibility="{x:Bind ShownIfTrue(ViewModel.InRaid), Mode=OneWay}">
              <Border Padding="14,0,14,12" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1,0,1,1">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Bind ViewModel.RaidSummary, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidSummary), Mode=OneWay}"
                             Foreground="{StaticResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                             ToolTipService.ToolTip="{x:Bind local:ViewTexts.CardSummaryTip}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidLineParts, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidLine), Mode=OneWay}"
                                ItemTemplate="{StaticResource LinePartTemplate}" ItemsPanel="{StaticResource LinePartsPanel}" IsTabStop="False"
                                AutomationProperties.Name="{x:Bind ViewModel.RaidLine, Mode=OneWay}" />
                  <!-- No loading progress here (owner, 2026-10-04: "we really don't need the loading progress bar in the
                       upper left, the game already shows a loading progress bar"). Until then a line named the last
                       loading step the log reported, over one segment per step. -->
                  <TextBlock Text="{x:Bind ViewModel.RaidFixNote, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidFixNote), Mode=OneWay}" Style="{StaticResource NoteText}" />
                  <TextBlock Text="{x:Bind ViewModel.RaidNote, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidNote), Mode=OneWay}" Style="{StaticResource NoteText}" TextWrapping="Wrap" />
                  <!-- While the raid loads: the kit to check, while matching can still be cancelled (owner, 2026-10-03). What
                       gets you in or out first, then the picks' items; with picks here the rest under ALSO USEFUL. A list
                       to check: Shturmap knows no inventory. Gone when the raid starts; BRING is back below then. -->
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RaidCheckYourKit}" Foreground="{StaticResource AmberBrush}" Margin="0,14,0,6"
                             Visibility="{x:Bind ShownIfAny(ViewModel.RaidKit), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidKit, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RaidAlsoUseful}" Margin="0,12,0,4"
                             Visibility="{x:Bind ShownIfAny(ViewModel.RaidKitMore), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidKitMore, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <!-- The glance: the nearest objective and the nearest way out, big, before anything else. Its labels share
                       one column, as wide as the longest of them in the language in use (Controls.Columns.Glance), so the
                       names line up. -->
                  <Grid Margin="-6,12,-6,0" Padding="6,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ShownIfSet(ViewModel.RaidNext), Mode=OneWay, FallbackValue=Collapsed}" controls:Linked.Quest="{x:Bind ViewModel.RaidNext.QuestId, Mode=OneWay}"
                        controls:Linked.Objective="{x:Bind ViewModel.RaidNext.ObjectiveId, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{x:Bind controls:Columns.Glance}" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind local:ViewTexts.RaidNextLabel}" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AmberBrush}" Margin="0,12,0,0" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,9">
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Text, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Quest, Mode=OneWay}" Style="{StaticResource NoteText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="10,8,0,8">
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Distance, Mode=OneWay}" Style="{StaticResource FigureText}" FontSize="22" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidNext.Direction), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11.5"
                                 Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="-6,0" Padding="6,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"
                        Visibility="{x:Bind ShownIfSet(ViewModel.RaidExit), Mode=OneWay, FallbackValue=Collapsed}" controls:Linked.Marker="{x:Bind ViewModel.RaidExit.Id, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{x:Bind controls:Columns.Glance}" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- In the colour of its kind, as its symbol on the map: a PMC extract green, a Scav's teal, one for
                         both sides khaki, a transit violet (2026-10-04: every way out was green here). -->
                    <TextBlock Text="{x:Bind local:ViewTexts.RaidExitLabel}" Style="{StaticResource EyebrowText}" Foreground="{x:Bind ViewModel.RaidExit.KindBrush, Mode=OneWay}" Margin="0,12,0,0" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,9">
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Needs, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap"
                                 Visibility="{x:Bind ShownIf(ViewModel.RaidExit.Needs), Mode=OneWay}" />
                      <!-- The game opens only some extracts each raid (owner, 2026-10-04): until a screenshot showed its
                           list, the nearest is named as only that, muted, with how to check; once the list was read,
                           this is the nearest one on it and says so in the way out's colour (owner, 2026-10-05;
                           Rules.ExitsNote). Two lines where the column is narrow (review of 2026-10-09: a wide direction,
                           "BEHIND-LEFT", cut it off mid-word). -->
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidExit.NearestNote), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="10.5"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True"
                                 Foreground="{x:Bind ViewModel.RaidExit.NoteBrush, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                 Visibility="{x:Bind ShownIf(ViewModel.RaidExit.NearestNote), Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind ViewModel.RaidExit.NearestTip, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="10,8,0,8">
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Distance, Mode=OneWay}" Style="{StaticResource FigureText}" FontSize="22" Foreground="{x:Bind ViewModel.RaidExit.KindBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidExit.Direction), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11.5"
                                 Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                      <!-- The other ways out stand under the card, a long way down in a raid with several quests (the
                           review of 2026-10-04, H5), and the nearest is often not one of the player's: one click
                           brings the whole list up. -->
                      <HyperlinkButton Padding="0" HorizontalAlignment="Right" Margin="0,4,0,0" Click="OnAllExitsClick"
                                       Visibility="{x:Bind ShownIf(ViewModel.AllExitsText), Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind local:ViewTexts.RaidAllExitsTip}">
                        <TextBlock Text="{x:Bind ViewModel.AllExitsText, Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="10.5"
                                   Foreground="{StaticResource AmberBrush}" />
                      </HyperlinkButton>
                    </StackPanel>
                  </Grid>
                  <!-- OR: where EXIT takes something or isn't sure, the nearest extract on the list that takes nothing
                       (owner, 2026-10-05: "where you can simply exfil"; Rules.ExitsNote.Plain). Smaller than EXIT: the
                       second answer to the same question. -->
                  <Grid Margin="-6,0" Padding="6,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ShownIfSet(ViewModel.RaidPlainExit), Mode=OneWay, FallbackValue=Collapsed}" controls:Linked.Marker="{x:Bind ViewModel.RaidPlainExit.Id, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind PlainExitTip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{x:Bind controls:Columns.Glance}" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind local:ViewTexts.RaidOrLabel}" Style="{StaticResource EyebrowText}" Foreground="{x:Bind ViewModel.RaidPlainExit.KindBrush, Mode=OneWay}" Margin="0,9,0,0" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,6">
                      <TextBlock Text="{x:Bind ViewModel.RaidPlainExit.Name, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind PlainExitNote}" Style="{StaticResource StatusText}" FontSize="10.5"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" controls:Fit.MayTrim="True"
                                 Foreground="{x:Bind ViewModel.RaidPlainExit.KindBrush, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="10,5,0,6">
                      <TextBlock Text="{x:Bind ViewModel.RaidPlainExit.Distance, Mode=OneWay}" Style="{StaticResource FigureText}" FontSize="17"
                                 Foreground="{x:Bind ViewModel.RaidPlainExit.KindBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidPlainExit.Direction), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11"
                                 Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  <!-- The picks first, nearest first, as in Plan. -->
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardPicked}" Margin="0,14,0,4"
                             Visibility="{x:Bind ShownIfAny(ViewModel.RaidPicks), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidPicks, Mode=OneWay}" ItemTemplate="{StaticResource RaidQuestTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardComplete}" Margin="0,14,0,4" Visibility="{x:Bind ShownIfAny(ViewModel.RaidComplete), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidComplete, Mode=OneWay}" ItemTemplate="{StaticResource RaidQuestTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardProgress}" Margin="0,14,0,4" Visibility="{x:Bind ShownIfAny(ViewModel.RaidProgress), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidProgress, Mode=OneWay}" ItemTemplate="{StaticResource RaidQuestTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.CardBring}" Margin="0,14,0,6" Visibility="{x:Bind ShownIfAny(ViewModel.RaidBring), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidBring, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <!-- A Scav raid: the loot your quests need found in raid takes the place of their objectives. -->
                  <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RaidFindInRaid}" Margin="0,14,0,6" Visibility="{x:Bind ShownIfAny(ViewModel.RaidLoot), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidLoot, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <TextBlock Text="{x:Bind ViewModel.RaidLootMore, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidLootMore), Mode=OneWay}"
                             Style="{StaticResource NoteText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="ExtractsHeading" Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.RaidExtractsHeading}" />
              <!-- Whether the game's own extract list was read this raid, or how to have it read (owner, 2026-10-05: "it
                   should also be visible if the exfils [are] not verified yet"; Rules.ExitsNote). -->
              <TextBlock Text="{x:Bind ViewModel.ExitsNote, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.ExitsNote), Mode=OneWay}"
                         Style="{StaticResource NoteText}" TextWrapping="Wrap" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Extracts, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ExtractItem">
                    <Grid Padding="6,5" Margin="-6,0" ColumnSpacing="10" controls:Linked.Marker="{x:Bind Id}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="1">
                        <!-- Once the game's list was read: an exit on it says so in its kind's colour; one it leaves
                             out is muted and comes last. -->
                        <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind NameBrush}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(KindLine)}" Style="{StaticResource StatusText}" FontSize="10.5" Foreground="{x:Bind KindLineBrush}" HorizontalAlignment="Left" />
                        <!-- What it takes to leave here: money, an item, a switch, climbing gear, a flare, a partner. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind NeedsVisibility}" Margin="0,2,0,0">
                          <controls:Picture ItemId="{x:Bind NeedItemId}" Size="20" Visibility="{x:Bind ItemVisibility}"
                                            controls:Linked.Item="{x:Bind NeedItemId}" controls:Linked.Inline="True" />
                          <TextBlock Text="{x:Bind Needs}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" MaxWidth="250" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Distance}" Style="{StaticResource FigureText}" Foreground="{x:Bind DistanceBrush}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Quests that move on in any raid, in Plan and in a PMC raid alike (a Scav's kills don't count; its loot
                 is in FIND IN RAID). -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.ScavRaid), Mode=OneWay}">
              <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:ViewTexts.AnyMapHeading}" Visibility="{x:Bind ShownIfAny(ViewModel.AnyMap), Mode=OneWay}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.AnyMap, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:QuestLine">
                    <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                      <controls:KeepToggle Grid.Column="2" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                      <controls:Picture Grid.Column="3" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- The map. -->
      <Grid Grid.Column="1">
        <controls:MapView x:Name="Map" />

        <!-- A change of view Shturmap made on its own (a raid loading, a transit, a Scav raid, the raid over): big, in
             the middle, for under three seconds, never taking a click. Owner, 2026-10-01. -->
        <Grid x:Name="CuePanel" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
          <!-- The band springs open behind the text; the text itself is never scaled, so it stays sharp. -->
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="CueBandScale" ScaleY="0" />
            </Grid.RenderTransform>
            <Border Background="#EB0B0C0B" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="0,1" />
            <Rectangle x:Name="CueFlash" Fill="{StaticResource AmberBrush}" Opacity="0" />
          </Grid>
          <StackPanel HorizontalAlignment="Center" Spacing="10" Padding="24,30">
            <Rectangle Height="2" Width="460" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,6">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="CueRuleTopScale" ScaleX="0" />
              </Rectangle.RenderTransform>
            </Rectangle>
            <!-- QUEST COMPLETE's stamp: the done objective's check on the quests' gold, popping in as a ring leaves it
                 (owner, 2026-10-07: "For completed quests, also make a nice animation"). No text in it, so scaling it
                 blurs nothing. -->
            <Grid x:Name="CueStamp" Width="44" Height="44" HorizontalAlignment="Center" Visibility="Collapsed">
              <Ellipse x:Name="CueStampRing" Width="44" Height="44" Stroke="{StaticResource AmberBrush}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="CueStampRingScale" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Grid x:Name="CueStampDisc" Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform x:Name="CueStampScale" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource AmberBrush}" />
                <Path Data="M 8.5,15.5 L 13,20 L 21.5,10.5" Stroke="{StaticResource GroundBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Grid>
            </Grid>
            <TextBlock x:Name="CueEyebrow" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed"
                       CharacterSpacing="400" Foreground="{StaticResource AmberBrush}" />
            <TextBlock x:Name="CueTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="48" FontWeight="SemiBold"
                       FontStretch="SemiCondensed" CharacterSpacing="160" Foreground="{StaticResource InkBrush}">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="CueTitleShift" />
              </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="CueDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" FontSize="15"
                       Foreground="{StaticResource MutedBrush}" />
            <!-- A raid loading's or a group pick's kit, pictured (owner, 2026-10-03: "with icon previews"): a reminder
                 to take in at a glance, "did I pack everything?", so pictures and nothing to read (owner, 2026-10-04).
                 Rows of eight, up to three, built in ShowCueKit; never scaled, like the text. -->
            <TextBlock x:Name="CueKitLabel" Text="{x:Bind local:ViewTexts.RaidCheckYourKit}" HorizontalAlignment="Center" Style="{StaticResource EyebrowText}" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="CueKit" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed" />
            <!-- The first raid's one extra line (owner, 2026-10-09, the tour's first-time lines): the habit Shturmap needs,
                 said when it matters. Once, then never again (MainWindow.Tour, FirstRaidLine). -->
            <TextBlock x:Name="CueFirst" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,10,0,0"
                       FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed" CharacterSpacing="200"
                       Foreground="{StaticResource AmberBrush}" Visibility="Collapsed" />
            <Rectangle Height="2" Width="460" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,6,0,0">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="CueRuleBottomScale" ScaleX="0" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </StackPanel>
        </Grid>

        <!-- The raid replay's band at the map's foot, the timeline in it (owner, 2026-10-07; Controls.ReplayBand). Clear of
             the map's buttons at the right, and over the WIKI MAP link and the artwork's credit, which stay readable. -->
        <controls:ReplayBand x:Name="ReplayBand" Visibility="Collapsed" Margin="0,0,68,46">
          <controls:ReplayBand.RenderTransform>
            <TranslateTransform x:Name="ReplayBandShift" />
          </controls:ReplayBand.RenderTransform>
        </controls:ReplayBand>

        <!-- What's New's preview of something that isn't on the map (the raid card's clock): the app's own control, with
             example values, on a plate over the dimmed map. -->
        <Grid x:Name="WhatsNewPlate" Visibility="Collapsed" IsHitTestVisible="False" Background="#960B0C0B">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <Border x:Name="WhatsNewPlateBox" Width="360" Padding="20,18" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" />
            <TextBlock x:Name="WhatsNewPlateNote" Style="{StaticResource EyebrowText}" Margin="0" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- One-line notices, top centre; they go by themselves. -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16" Spacing="8">
        <Border HorizontalAlignment="Center" MaxWidth="900" Padding="14,8,6,8"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIfTrue(ViewModel.NoticeOpen), Mode=OneWay}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <!-- A notice that asks for a report says where: the Report dialog (Copy diagnostics in a build without one). -->
              <HyperlinkButton Padding="6,0" Click="OnNoticeReportClick" VerticalAlignment="Center"
                               Visibility="{x:Bind ShownIfTrue(ViewModel.NoticeOffersReport), Mode=OneWay}">
                <TextBlock Text="{x:Bind ReportOfferText}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
              </HyperlinkButton>
              <Button Width="24" Height="24" Padding="0" Click="OnNoticeClosed" Background="Transparent" BorderThickness="0"
                      ToolTipService.ToolTip="{x:Bind local:ViewTexts.NoticeDismissTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.NoticeDismissName}">
                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <!-- After a crash: the one question, until answered (docs/DESIGN.md §8, "Reports"). Not in a raid: it lies
             over the map and waits for a click nobody is there to make; it is back when the raid is over. -->
        <Border HorizontalAlignment="Center" MaxWidth="900" Padding="14,10,10,10"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownUnlessHeldBack(ViewModel.CrashQuestion, ViewModel.RaidHoldsBack), Mode=OneWay}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Top" Margin="0,7,0,0" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{x:Bind ViewModel.CrashQuestion, Mode=OneWay}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="18" Visibility="{x:Bind ShownIfTrue(ViewModel.CrashAsking), Mode=OneWay}">
                <HyperlinkButton Padding="0" Click="OnCrashSendClick">
                  <TextBlock Text="{x:Bind local:ViewTexts.CrashSend}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                </HyperlinkButton>
                <HyperlinkButton Padding="0" Click="OnCrashKeepClick">
                  <TextBlock Text="{x:Bind local:ViewTexts.CrashDontSend}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                </HyperlinkButton>
                <HyperlinkButton Padding="0" Click="OnCrashAlwaysClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.CrashAlwaysSendTip}">
                  <TextBlock Text="{x:Bind local:ViewTexts.CrashAlwaysSend}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </HyperlinkButton>
                <HyperlinkButton Padding="0" Click="OnCrashDetailsClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.CrashWhatsSentTip}">
                  <TextBlock Text="{x:Bind local:ViewTexts.CrashWhatsSent}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </HyperlinkButton>
              </StackPanel>
              <HyperlinkButton Padding="0" Click="OnCrashNoteClick" Visibility="{x:Bind ShownIfTrue(ViewModel.CrashSent), Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind local:ViewTexts.CrashAddNoteTip}">
                <TextBlock Text="{x:Bind local:ViewTexts.CrashAddNote}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
              </HyperlinkButton>
              <ScrollViewer MaxHeight="220" Visibility="{x:Bind ShownIf(ViewModel.CrashDetails), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.CrashDetails, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" IsTextSelectionEnabled="True" />
              </ScrollViewer>
            </StackPanel>
            <Button Grid.Column="2" Width="24" Height="24" Padding="0" Click="OnCrashLaterClick" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind local:ViewTexts.CrashLater}" AutomationProperties.Name="{x:Bind local:ViewTexts.CrashLater}">
              <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
            </Button>
          </Grid>
        </Border>
        <!-- Another map shown for a moment from its row in Plan under the pointer. -->
        <Border HorizontalAlignment="Center" Padding="14,6" Background="#F00B0C0B" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIf(ViewModel.PreviewText), Mode=OneWay}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="{x:Bind ViewModel.PreviewHint, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Border>
        <!-- In a raid, another map picked in the MAP list is a look: the rail stays the raid's, and this says so. -->
        <Border HorizontalAlignment="Center" Padding="14,6" Background="#F00B0C0B" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIf(ViewModel.LookText), Mode=OneWay}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{x:Bind ViewModel.LookText, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="{x:Bind ViewModel.LookNote, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="4">
          <!-- Floors, top first. Shturmap shows yours (dot) from each screenshot; a pick here holds until the next one. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.Floors, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,0,12"
                        ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapFloorsTip}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FloorChoice">
                <Button Tag="{x:Bind Index}" Click="OnFloorClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,0,0,-1" BorderBrush="{x:Bind Border}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Rectangle Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" Visibility="{x:Bind PlayerVisibility}" />
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource StatusText}" FontSize="11.5" Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Follow my position (owner, 2026-10-03): on, a new position glides into the middle; dragging or showing the
               whole map turns it off. Its own symbol (four arrows about a centre); on, in amber, the app's colour for
               "on" (cyan is the picks' alone; 2026-10-04). -->
          <ToggleButton x:Name="FollowButton" Style="{StaticResource MapToggleButton}" Click="OnFollowClick"
                        ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapFollowTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.MapFollowName}">
            <ToggleButton.Resources>
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ToggleButtonBackground" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ToggleButtonBackgroundPointerOver" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ToggleButtonBackgroundPressed" />
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AmberBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AmberBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AmberBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AmberBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AmberBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AmberBrush" />
            </ToggleButton.Resources>
            <FontIcon Glyph="&#xE759;" FontSize="15" />
          </ToggleButton>
          <!-- Off, the view only moves when you move it: a new position pings instead. This shows it. -->
          <Button Style="{StaticResource MapButton}" Click="OnShowMeClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapShowMeTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.MapShowMeName}"><FontIcon Glyph="&#xE81D;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnFitClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapFitTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.MapFitName}"><FontIcon Glyph="&#xE9A6;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomInClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapZoomInTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.MapZoomInName}"><FontIcon Glyph="&#xE710;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomOutClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapZoomOutTip}" AutomationProperties.Name="{x:Bind local:ViewTexts.MapZoomOutName}"><FontIcon Glyph="&#xE738;" FontSize="15" /></Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,10" Spacing="2">
          <!-- The wiki's interactive map, for what Shturmap doesn't draw (loot, containers, stashes). -->
          <HyperlinkButton Padding="0" NavigateUri="{x:Bind ViewModel.WikiMap, Mode=OneWay}" Click="OnWikiMapClick"
                           Visibility="{x:Bind ShownIfLink(ViewModel.WikiMap), Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind local:ViewTexts.MapWikiMapTip}">
            <TextBlock Text="{x:Bind local:ViewTexts.MapWikiMap}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
          </HyperlinkButton>
          <TextBlock Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Style="{StaticResource NoteText}" FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- The tour (owner, 2026-10-09; docs/DESIGN.md §4, "Screen anatomy", *The tour*): the window dimmed around the parts a
         chapter is about, each framed with the map sheet's corner marks; the chapter in a band at the map's foot; an
         example staged on the map. It covers the window as the Report dialog does, by the owner's exception to principle 3,
         and only outside raids; clicks outside its band do nothing (MainWindow.Tour). -->
    <Grid x:Name="TourLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" SizeChanged="OnTourLayerSizeChanged">
      <Path x:Name="TourShade" Fill="#DB0B0C0B" IsHitTestVisible="False" />
      <!-- The same dim over cut-outs that fade in or out (a chapter without parts, or the first with them). -->
      <Path x:Name="TourVeil" Fill="#DB0B0C0B" IsHitTestVisible="False" />
      <Path x:Name="TourMarks" Stroke="{StaticResource AmberBrush}" StrokeThickness="2" IsHitTestVisible="False" />
      <Canvas x:Name="TourCanvas" IsHitTestVisible="False" />
      <!-- The map's part above the band: a stage's plate stands in its middle (MainWindow.Tour, PlaceTour), opaque as the
           band is (review of 2026-10-09: the map's labels read through the example raid card). -->
      <Grid x:Name="TourStage" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border x:Name="TourPlate" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,10"
                Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="30,24" />
      </Grid>
      <!-- Opaque: the map's labels showed through its words (review of 2026-10-09). The buttons stand beside the eyebrow
           and the title; the chapter's lines run under both, the band's whole width, and a title that doesn't fit beside
           them goes under them, across the band, wrapping only past that (review of 2026-10-10: at the smallest window,
           900×560, "IT FOLLOWS THE GAME" was cut off, and the lines took five rows beside the buttons, so the stage above
           had no room for the example raid card). -->
      <Border x:Name="TourBand" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource GroundBrush}" SizeChanged="OnTourLayerSizeChanged"
              BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="0,1" Padding="22,14,22,12">
        <!-- Rows: the eyebrow; the title beside the buttons, or under them (PlaceTourTitle); the lines; the ticks. -->
        <Grid ColumnSpacing="28">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- A gold rule shoots out along the band's top at each chapter, as the cue's rules do. -->
          <Rectangle Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Margin="-22,-15,-22,0" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
              <ScaleTransform x:Name="TourRuleScale" ScaleX="0" />
            </Rectangle.RenderTransform>
          </Rectangle>
          <TextBlock x:Name="TourEyebrow" FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed" CharacterSpacing="300" Foreground="{StaticResource AmberBrush}" />
          <TextBlock x:Name="TourTitle" Grid.Row="1" Margin="0,6,0,0" FontSize="30" FontWeight="SemiBold" FontStretch="SemiCondensed" CharacterSpacing="120" TextWrapping="Wrap"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock x:Name="TourText" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="15" LineHeight="21" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left"
                     Foreground="{StaticResource InkBrush}" />
          <StackPanel x:Name="TourButtons" Grid.Column="1" Grid.RowSpan="2" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right">
              <HyperlinkButton x:Name="TourBack" Padding="0" Click="OnTourBackClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.TourBackTip}">
                <TextBlock Text="{x:Bind local:ViewTexts.TourBack}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
              </HyperlinkButton>
              <HyperlinkButton Padding="0" Click="OnTourNextClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.TourNextTip}">
                <TextBlock x:Name="TourNextText" Text="{x:Bind local:ViewTexts.TourNext}" Style="{StaticResource StatusText}" Foreground="{StaticResource AmberBrush}" />
              </HyperlinkButton>
            </StackPanel>
            <HyperlinkButton Padding="0" HorizontalAlignment="Right" Click="OnTourEndClick" ToolTipService.ToolTip="{x:Bind local:ViewTexts.TourEndTip}">
              <TextBlock Text="{x:Bind local:ViewTexts.TourEnd}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </HyperlinkButton>
          </StackPanel>
          <Grid x:Name="TourTicks" Grid.Row="4" Grid.ColumnSpan="2" ColumnSpacing="5" Height="4" Margin="0,10,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- Report a problem or idea: the one way to report, no account, no browser (owner, 2026-10-03; docs/DESIGN.md §8,
         "Reports"). Over the whole window, between raids; Esc or Cancel closes it, the text stays until sent. -->
    <Grid x:Name="ReportOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#C80B0C0B">
      <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18,22,16"
              Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind local:ViewTexts.ReportTitle}" Style="{StaticResource TitleText}" CharacterSpacing="80" />
          <StackPanel Orientation="Horizontal" Spacing="-1">
            <ToggleButton x:Name="ReportProblem" Content="{x:Bind local:ViewTexts.ReportProblem}" Click="OnReportKindClick" Tag="Problem" Padding="14,4" FontSize="11.5"
                          FontWeight="SemiBold" FontStretch="SemiCondensed" CharacterSpacing="80" IsChecked="True" />
            <ToggleButton x:Name="ReportIdea" Content="{x:Bind local:ViewTexts.ReportIdea}" Click="OnReportKindClick" Tag="Idea" Padding="14,4" FontSize="11.5"
                          FontWeight="SemiBold" FontStretch="SemiCondensed" CharacterSpacing="80" />
          </StackPanel>
          <TextBox x:Name="ReportText" AcceptsReturn="True" TextWrapping="Wrap" Height="150" MaxLength="4000"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnReportInputChanged"
                   PlaceholderText="{x:Bind local:ViewTexts.ReportTextPlaceholder}" />
          <TextBox x:Name="ReportContact" MaxLength="120" TextChanged="OnReportInputChanged"
                   PlaceholderText="{x:Bind local:ViewTexts.ReportContactPlaceholder}" />
          <StackPanel Orientation="Horizontal" Spacing="18">
            <ToggleButton x:Name="ReportIncludeDiagnostics" IsChecked="True" Click="OnReportDiagnosticsClick"
                          AutomationProperties.Name="{x:Bind local:ViewTexts.ReportIncludeDiagnostics}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border x:Name="ReportDiagnosticsBox" Width="13" Height="13" BorderThickness="1" BorderBrush="{StaticResource AmberBrush}"
                        Background="{StaticResource AmberBrush}" VerticalAlignment="Center">
                  <FontIcon x:Name="ReportDiagnosticsCheck" Glyph="&#xE73E;" FontSize="9" Foreground="{StaticResource GroundBrush}" />
                </Border>
                <TextBlock Text="{x:Bind local:ViewTexts.ReportIncludeDiagnostics}" FontWeight="SemiBold" />
              </StackPanel>
            </ToggleButton>
            <HyperlinkButton Padding="0" Click="OnReportShowSentClick" VerticalAlignment="Center">
              <TextBlock x:Name="ReportShowSentText" Text="{x:Bind local:ViewTexts.ReportShowSent}" Style="{StaticResource StatusText}" FontSize="11"
                         Foreground="{StaticResource AmberBrush}" />
            </HyperlinkButton>
          </StackPanel>
          <ScrollViewer x:Name="ReportSentView" MaxHeight="200" Visibility="Collapsed" Padding="10,8"
                        Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <TextBlock x:Name="ReportSentText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{StaticResource MutedBrush}" />
          </ScrollViewer>
          <TextBlock Style="{StaticResource NoteText}">
            <Run Text="{x:Bind local:ViewTexts.ReportPrivacyNote}" /><Hyperlink Click="OnPrivacyLinkClick" Foreground="{StaticResource AmberBrush}" UnderlineStyle="None"><Run Text="{x:Bind local:ViewTexts.ReportPrivacyLink}" /></Hyperlink>
          </TextBlock>
          <TextBlock x:Name="ReportStatusText" TextWrapping="Wrap" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
            <Button x:Name="ReportCancel" Content="{x:Bind local:ViewTexts.ReportCancel}" Click="OnReportCancelClick" Padding="16,5" FontSize="11.5" FontWeight="SemiBold"
                    FontStretch="SemiCondensed" CharacterSpacing="80" />
            <Button x:Name="ReportSend" Content="{x:Bind local:ViewTexts.ReportSend}" Click="OnReportSendClick" Padding="20,5" FontSize="11.5" FontWeight="SemiBold"
                    FontStretch="SemiCondensed" CharacterSpacing="80" BorderBrush="{StaticResource AmberBrush}"
                    Foreground="{StaticResource AmberBrush}" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
