<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shturmap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shturmap.App"
    xmlns:controls="using:Shturmap.App.Controls"
    Title="Shturmap">

  <Grid Background="{StaticResource GroundBrush}">
    <Grid.Resources>
      <!-- Something to bring, in Plan's cards and the raid card. -->
      <DataTemplate x:Key="RequirementTemplate" x:DataType="local:RequirementLine">
        <Grid ColumnSpacing="12" Padding="6,4" Margin="-6,0"
              controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Quests="{x:Bind QuestIds}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Picture ItemId="{x:Bind ItemId}" Glyph="{x:Bind Glyph}" Size="40" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind For}" Style="{StaticResource NoteText}" />
            <TextBlock Text="{x:Bind Source}" Style="{StaticResource NoteText}" Foreground="{StaticResource AmberBrush}"
                       Visibility="{x:Bind SourceVisibility}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

      <!-- A quest in the raid card: its line as in Plan, then its objectives here with how far and which way.
           The whole block is one quest: pointing at it lights the quest up everywhere, clicking keeps it lit. -->
      <DataTemplate x:Key="RaidQuestTemplate" x:DataType="local:RaidQuest">
        <StackPanel Padding="6,4,6,6" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{x:Bind GlyphBrush}" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{x:Bind NameBrush}" TextWrapping="Wrap" />
            <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
            <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
            <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="{x:Bind PictureOpacity}" />
          </Grid>
          <ItemsControl ItemsSource="{x:Bind Objectives}" Margin="26,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ObjectiveItem">
                <Grid ColumnSpacing="10" Padding="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="13" Foreground="{x:Bind TextBrush}" />
                    <TextBlock Text="{x:Bind Needs}" Visibility="{x:Bind NeedsVisibility}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Distance}" Style="{StaticResource FigureText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Status bar: mode, raid, last fix on the left; the inputs as small status lights and help on the right. -->
    <Grid Padding="16,0,10,0" ColumnSpacing="16" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="SHTURMAP" Style="{StaticResource StatusText}" FontWeight="Bold" CharacterSpacing="320" />
        <Rectangle Width="1" Height="16" Fill="{StaticResource LineStrongBrush}" VerticalAlignment="Center" />
        <DropDownButton Content="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="12"
                        Padding="6,2" VerticalAlignment="Center" ToolTipService.ToolTip="Game mode (follows the game's log)">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem Text="PvE" Tag="Pve" Click="OnModeClick" />
              <MenuFlyoutItem Text="PvP" Tag="Pvp" Click="OnModeClick" />
              <MenuFlyoutItem Text="Seasonal" Tag="Seasonal" Click="OnModeClick" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidText), Mode=OneWay}" Style="{StaticResource StatusText}"
                   Foreground="{x:Bind RaidBrush(ViewModel.InRaid), Mode=OneWay}" />
        <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.FixText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.LogsOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.LogsText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.ScreenshotsOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.ScreenshotsText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Rectangle Width="6" Height="6" Fill="{x:Bind OkBrush(ViewModel.DataOk), Mode=OneWay}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.DataText), Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <Button x:Name="HelpButton" Width="28" Height="28" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="How Shturmap works (F1)">
          <TextBlock Text="?" Style="{StaticResource StatusText}" HorizontalAlignment="Center" />
          <Button.Flyout>
            <Flyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight" Opened="OnHelpOpened" Closed="OnHelpClosed">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                  <Setter Property="MaxWidth" Value="540" />
                  <Setter Property="Padding" Value="18,16" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <StackPanel Width="480" Spacing="8">
                <TextBlock Text="HOW SHTURMAP WORKS" Style="{StaticResource TitleText}" CharacterSpacing="80" />
                <TextBlock TextWrapping="Wrap">
                  <Run Text="In a raid, press " /><Run Text="{x:Bind ViewModel.HelpKeys, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" /><Run Text=". The game names each screenshot with your position; Shturmap moves your marker, picks the floor and sorts your objectives by distance. The map stays where you put it: your new position pings, and an arrow at the edge points to it when it is out of view (F shows it)." />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="The map, the raid and your quest progress follow the game's logs on their own. Nothing needs clicking while you play." />
                <TextBlock TextWrapping="Wrap" Text="Between raids, Shturmap suggests where to go next, what you can complete there and what to bring. In a raid, the same card stays up for the map you're on, with each quest's objectives under it: how far, which way." />
                <TextBlock TextWrapping="Wrap" Text="Point at a quest, in the list or on the map, to see its card and light up everywhere else it appears. Click it to keep its card open. To keep it lit on the map, click its highlighter (the pen beside it, or on its card): its markers turn cyan, larger and ringed, with a line from you to the nearest, until you click it again or press Esc. Move into a card and point at a key, an item or a quest in it for that one's card. Pin a card to keep it as a small window; in a raid it shows how far each objective is." />
                <TextBlock Style="{StaticResource NoteText}" Text="Quests come from the game's logs alone, so a quest started before your oldest log isn't shown." />

                <TextBlock Style="{StaticResource EyebrowText}" Text="KEYS · WHEN THIS WINDOW HAS FOCUS" />
                <ItemsControl ItemsSource="{x:Bind Keys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:KeyHelp">
                      <Grid ColumnSpacing="12" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{x:Bind Key}" Style="{StaticResource StatusText}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Action}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EyebrowText}" Text="QUEST TYPES" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Legend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LegendItem">
                      <Grid ColumnSpacing="10" Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Explanation}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EyebrowText}" Text="ON THE MAP" />
                <!-- Drawn by the map's own renderer (MapLegend), most important first. -->
                <ItemsControl ItemsSource="{x:Bind MapLegendRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MapLegendRow">
                      <Grid ColumnSpacing="10" Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind Swatch}" Width="56" Height="34" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource NoteText}" Margin="0,10,0,0"
                           Text="Shturmap only reads your screenshots' names, the game's logs and public tarkov.dev data. It never touches the game. It keeps a study log of raids and how you use it in %LOCALAPPDATA%\Shturmap\study; nothing is sent anywhere." />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="384" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: Plan between raids, Raid during one. The state follows the game. -->
      <Grid Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="16,4,16,0">
          <TextBlock Style="{StaticResource EyebrowText}" Text="MAP" Margin="0,14,0,6" />
          <ComboBox HorizontalAlignment="Stretch" FontStretch="SemiCondensed" FontWeight="SemiBold"
                    ItemsSource="{x:Bind ViewModel.MapChoices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}"
                    SelectionChanged="OnMapPicked" />
        </StackPanel>
        <ScrollViewer x:Name="RailScroll" Grid.Row="1" Padding="16,0,16,20" ViewChanged="OnRailScrolled">
          <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.Hint), Mode=OneWay}"
                       Style="{StaticResource NoteText}" Margin="0,16,0,0" />

            <!-- PLAN -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Style="{StaticResource EyebrowText}" Text="{x:Bind local:Caps.Of(ViewModel.LastRaidText), Mode=OneWay}"
                         Visibility="{x:Bind ShownIf(ViewModel.LastRaidText), Mode=OneWay}" Margin="0,18,0,0" />
              <TextBlock Style="{StaticResource EyebrowText}" Text="NEXT RAID" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PlanCard">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12" Margin="0,0,0,6"
                            Background="{x:Bind CardBackground}" BorderBrush="{x:Bind CardBorder}" BorderThickness="1"
                            Tag="{x:Bind NormalizedName}" Click="OnPlanClick"
                            PointerEntered="OnPlanPointerEntered" PointerExited="OnPlanPointerExited">
                      <StackPanel Spacing="3">
                        <Grid>
                          <TextBlock Text="{x:Bind MapTitle}" Style="{StaticResource TitleText}" CharacterSpacing="60" />
                          <TextBlock Text="{x:Bind Rank}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind Summary}" Foreground="{StaticResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="A quest counts as one to complete when all its raid objectives can be done on this map in one raid, and none needs found-in-raid items or more than 3 kills. The others only progress here." />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NoteText}" />
                        <!-- Folded: enough to compare without opening it. One glyph per quest (gold: complete, muted:
                             progress), then what to bring. -->
                        <Grid Visibility="{x:Bind FoldedVisibility}" Margin="0,5,0,0" ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <ItemsControl ItemsSource="{x:Bind Finish}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" ToolTipService.ToolTip="{x:Bind Name}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind Progress}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QuestLine">
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" ToolTipService.ToolTip="{x:Bind Name}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <controls:NeedsStrip Grid.Column="1" Needs="{x:Bind Needs}" Shown="5" />
                        </Grid>
                        <StackPanel Visibility="{x:Bind ExpandedVisibility}">
                          <TextBlock Style="{StaticResource EyebrowText}" Text="COMPLETE" Margin="0,14,0,4" Visibility="{x:Bind FinishVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Finish}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                  <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" />
                                  <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                                  <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="PROGRESS" Margin="0,14,0,4" Visibility="{x:Bind ProgressVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Progress}" Visibility="{x:Bind ProgressVisibility}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:QuestLine">
                                <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                  <controls:NeedsStrip Grid.Column="2" Needs="{x:Bind Needs}" Opacity="0.75" />
                                  <controls:KeepToggle Grid.Column="3" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                                  <controls:Picture Grid.Column="4" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.6" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Style="{StaticResource EyebrowText}" Text="BRING" Margin="0,14,0,6" Visibility="{x:Bind RequirementsVisibility}" />
                          <ItemsControl ItemsSource="{x:Bind Requirements}" Visibility="{x:Bind RequirementsVisibility}"
                                        ItemTemplate="{StaticResource RequirementTemplate}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- RAID: the map's Plan card, live. The same header and COMPLETE / PROGRESS / BRING; each quest carries its
                 objectives here, nearest first, and the quests are ordered by their nearest objective. -->
            <StackPanel Visibility="{x:Bind ShownIfTrue(ViewModel.InRaid), Mode=OneWay}">
              <TextBlock Style="{StaticResource EyebrowText}" Text="THIS RAID" Margin="0,18,0,6" />
              <Border Padding="14,12" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                <StackPanel Spacing="3">
                  <Grid>
                    <TextBlock Text="{x:Bind ViewModel.RaidTitle, Mode=OneWay}" Style="{StaticResource TitleText}" CharacterSpacing="60" />
                    <TextBlock Text="{x:Bind ViewModel.RaidSide, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               Visibility="{x:Bind ShownIfNot(ViewModel.SideSwitchable), Mode=OneWay}"
                               ToolTipService.ToolTip="The side you play this raid, from the game's log" />
                    <!-- A raid hosted on your own machine (PvE can be) looks the same in the log for a PMC and a
                         Scav: then the tag is a switch. -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" Click="OnSideClick"
                            Visibility="{x:Bind ShownIfTrue(ViewModel.SideSwitchable), Mode=OneWay}"
                            ToolTipService.ToolTip="This raid runs on your own machine, and then the game's log doesn't say which side you play. Click to switch between PMC and Scav for this raid.">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Bind ViewModel.RaidSide, Mode=OneWay}" Style="{StaticResource StatusText}" />
                        <FontIcon Glyph="&#xE8AB;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Text="{x:Bind ViewModel.RaidSummary, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidSummary), Mode=OneWay}"
                             Foreground="{StaticResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                             ToolTipService.ToolTip="A quest counts as one to complete when all its raid objectives can be done on this map in one raid, and none needs found-in-raid items or more than 3 kills. The others only progress here." />
                  <TextBlock Text="{x:Bind ViewModel.RaidLine, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidLine), Mode=OneWay}" Style="{StaticResource NoteText}" />
                  <!-- While the raid loads: the last step the game's log reported, and one segment per loading step that
                       lights once the log reports that step; nothing estimated (LoadingProgress). Gone once the raid starts. -->
                  <StackPanel Spacing="5" Margin="0,8,0,2" Visibility="{x:Bind ShownIf(ViewModel.LoadingText), Mode=OneWay}"
                              ToolTipService.ToolTip="The loading steps the game has reported in its log">
                    <TextBlock Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
                    <Grid x:Name="LoadingSegments" Height="2" ColumnSpacing="3" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind ViewModel.RaidFixNote, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidFixNote), Mode=OneWay}" Style="{StaticResource NoteText}" />
                  <TextBlock Text="{x:Bind ViewModel.RaidNote, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidNote), Mode=OneWay}" Style="{StaticResource NoteText}" TextWrapping="Wrap" />
                  <!-- The glance: the nearest objective and the nearest way out, big, before anything else. -->
                  <Grid Margin="-6,12,-6,0" Padding="6,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ShownIfSet(ViewModel.RaidNext), Mode=OneWay}" controls:Linked.Quest="{x:Bind ViewModel.RaidNext.QuestId, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NEXT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AmberBrush}" Margin="0,12,0,0" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,9">
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Text, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Quest, Mode=OneWay}" Style="{StaticResource NoteText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="10,8,0,8">
                      <TextBlock Text="{x:Bind ViewModel.RaidNext.Distance, Mode=OneWay}" Style="{StaticResource FigureText}" FontSize="22" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidNext.Direction), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11.5"
                                 Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="-6,0" Padding="6,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"
                        Visibility="{x:Bind ShownIfSet(ViewModel.RaidExit), Mode=OneWay}" controls:Linked.Marker="{x:Bind ViewModel.RaidExit.Id, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EXIT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource GreenBrush}" Margin="0,12,0,0" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,9">
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Needs, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap"
                                 Visibility="{x:Bind ShownIf(ViewModel.RaidExit.Needs), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="10,8,0,8">
                      <TextBlock Text="{x:Bind ViewModel.RaidExit.Distance, Mode=OneWay}" Style="{StaticResource FigureText}" FontSize="22" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind local:Caps.Of(ViewModel.RaidExit.Direction), Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="11.5"
                                 Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource EyebrowText}" Text="COMPLETE" Margin="0,14,0,4" Visibility="{x:Bind ShownIfAny(ViewModel.RaidComplete), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidComplete, Mode=OneWay}" ItemTemplate="{StaticResource RaidQuestTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="PROGRESS" Margin="0,14,0,4" Visibility="{x:Bind ShownIfAny(ViewModel.RaidProgress), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidProgress, Mode=OneWay}" ItemTemplate="{StaticResource RaidQuestTemplate}" />
                  <TextBlock Style="{StaticResource EyebrowText}" Text="BRING" Margin="0,14,0,6" Visibility="{x:Bind ShownIfAny(ViewModel.RaidBring), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidBring, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <!-- A Scav raid: the loot your quests need found in raid takes the place of their objectives. -->
                  <TextBlock Style="{StaticResource EyebrowText}" Text="FIND IN RAID" Margin="0,14,0,6" Visibility="{x:Bind ShownIfAny(ViewModel.RaidLoot), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.RaidLoot, Mode=OneWay}" ItemTemplate="{StaticResource RequirementTemplate}" />
                  <TextBlock Text="{x:Bind ViewModel.RaidLootMore, Mode=OneWay}" Visibility="{x:Bind ShownIf(ViewModel.RaidLootMore), Mode=OneWay}"
                             Style="{StaticResource NoteText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource EyebrowText}" Text="EXTRACTS AND TRANSITS" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Extracts, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ExtractItem">
                    <Grid Padding="6,5" Margin="-6,0" ColumnSpacing="10" controls:Linked.Marker="{x:Bind Id}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Kind)}" Style="{StaticResource StatusText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                        <!-- What it takes to leave here: money, an item, a switch, climbing gear, a flare, a partner. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind NeedsVisibility}" Margin="0,2,0,0">
                          <controls:Picture ItemId="{x:Bind NeedItemId}" Size="20" Visibility="{x:Bind ItemVisibility}" />
                          <TextBlock Text="{x:Bind Needs}" FontSize="12.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" MaxWidth="250" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Distance}" Style="{StaticResource FigureText}" Foreground="{StaticResource GreenBrush}" />
                        <TextBlock Text="{x:Bind local:Caps.Of(Direction)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Quests that move on in any raid, in Plan and in a PMC raid alike (a Scav's kills don't count; its loot
                 is in FIND IN RAID). -->
            <StackPanel Visibility="{x:Bind ShownIfNot(ViewModel.ScavRaid), Mode=OneWay}">
              <TextBlock Style="{StaticResource EyebrowText}" Text="ANY MAP" Visibility="{x:Bind ShownIfAny(ViewModel.AnyMap), Mode=OneWay}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.AnyMap, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:QuestLine">
                    <Grid ColumnSpacing="10" Padding="6,4" Margin="-6,0" controls:Linked.Quest="{x:Bind QuestId}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <controls:KeepToggle Grid.Column="2" QuestId="{x:Bind QuestId}" Margin="0,-2,0,0" />
                      <controls:Picture Grid.Column="3" TraderId="{x:Bind TraderId}" Title="{x:Bind TraderName}" Size="20" Opacity="0.6" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- The map. -->
      <Grid Grid.Column="1">
        <controls:MapView x:Name="Map" />

        <!-- A change of view Shturmap made on its own (a raid loading, a transit, a Scav raid, the raid over): big, in
             the middle, for under three seconds, never taking a click. Owner, 2026-10-01. -->
        <Grid x:Name="CuePanel" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
          <!-- The band springs open behind the text; the text itself is never scaled, so it stays sharp. -->
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="CueBandScale" ScaleY="0" />
            </Grid.RenderTransform>
            <Border Background="#EB0B0C0B" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="0,1" />
            <Rectangle x:Name="CueFlash" Fill="{StaticResource AmberBrush}" Opacity="0" />
          </Grid>
          <StackPanel HorizontalAlignment="Center" Spacing="10" Padding="24,30">
            <Rectangle Height="2" Width="460" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,6">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="CueRuleTopScale" ScaleX="0" />
              </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock x:Name="CueEyebrow" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed"
                       CharacterSpacing="400" Foreground="{StaticResource AmberBrush}" />
            <TextBlock x:Name="CueTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="48" FontWeight="SemiBold"
                       FontStretch="SemiCondensed" CharacterSpacing="160" Foreground="{StaticResource InkBrush}">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="CueTitleShift" />
              </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="CueDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" FontSize="15"
                       Foreground="{StaticResource MutedBrush}" />
            <Rectangle Height="2" Width="460" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,6,0,0">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="CueRuleBottomScale" ScaleX="0" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </StackPanel>
        </Grid>

        <!-- One-line notices, top centre; they go by themselves. -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16" Spacing="8">
        <Border HorizontalAlignment="Center" MaxWidth="900" Padding="14,8,6,8"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIfTrue(ViewModel.NoticeOpen), Mode=OneWay}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Width="24" Height="24" Padding="0" Click="OnNoticeClosed" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Dismiss">
              <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource MutedBrush}" />
            </Button>
          </Grid>
        </Border>
        <!-- Another map shown for a moment from a Plan card under the pointer. -->
        <Border HorizontalAlignment="Center" Padding="14,6" Background="#F00B0C0B" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                Visibility="{x:Bind ShownIf(ViewModel.PreviewText), Mode=OneWay}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Style="{StaticResource StatusText}" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="CLICK THE CARD TO PLAN IT" Style="{StaticResource StatusText}" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Border>
        <!-- In a raid, an old position says so in big type: a glance must not mistake it for where you are now. -->
        <Border x:Name="StaleBanner" HorizontalAlignment="Center" Padding="18,10" RenderTransformOrigin="0.5,0.5"
                Background="#F00B0C0B" BorderBrush="{StaticResource AmberBrush}" BorderThickness="2"
                Visibility="{x:Bind ShownIf(ViewModel.StaleText), Mode=OneWay}" IsHitTestVisible="False">
          <Border.RenderTransform>
            <ScaleTransform x:Name="StaleScale" />
          </Border.RenderTransform>
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.StaleText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                       FontStretch="SemiCondensed" CharacterSpacing="120" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="{x:Bind ViewModel.StaleHint, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource StatusText}"
                       Foreground="{StaticResource InkBrush}" />
          </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="4">
          <!-- Floors, top first. Shturmap shows yours (dot) from each screenshot; a pick here holds until the next one. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.Floors, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,0,12"
                        ToolTipService.ToolTip="Floors. Shturmap shows yours (dot) from each screenshot; pick another, or use PgUp / PgDn, to look around until your next screenshot.">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FloorChoice">
                <Button Tag="{x:Bind Index}" Click="OnFloorClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,0,0,-1" BorderBrush="{x:Bind Border}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Rectangle Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" Visibility="{x:Bind PlayerVisibility}" />
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource StatusText}" FontSize="11.5" Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- The view only moves when you move it: a new position pings instead. This shows it. -->
          <Button Style="{StaticResource MapButton}" Click="OnShowMeClick" ToolTipService.ToolTip="Show my position (F)"><FontIcon Glyph="&#xE81D;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnFitClick" ToolTipService.ToolTip="Show the whole map (0)"><FontIcon Glyph="&#xE9A6;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomInClick" ToolTipService.ToolTip="Zoom in (+)"><FontIcon Glyph="&#xE710;" FontSize="15" /></Button>
          <Button Style="{StaticResource MapButton}" Click="OnZoomOutClick" ToolTipService.ToolTip="Zoom out (−)"><FontIcon Glyph="&#xE738;" FontSize="15" /></Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,10" Spacing="2">
          <!-- The wiki's interactive map, for what Shturmap doesn't draw (loot, containers, stashes). -->
          <HyperlinkButton Padding="0" NavigateUri="{x:Bind ViewModel.WikiMap, Mode=OneWay}" Click="OnWikiMapClick"
                           Visibility="{x:Bind ShownIfLink(ViewModel.WikiMap), Mode=OneWay}"
                           ToolTipService.ToolTip="Opens this map's interactive map on the Escape from Tarkov wiki in your browser">
            <TextBlock Text="WIKI MAP ↗" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
          </HyperlinkButton>
          <TextBlock Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Style="{StaticResource NoteText}" FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
