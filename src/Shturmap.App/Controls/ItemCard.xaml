<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Shturmap.App.Controls.ItemCard"
    FontFamily="{StaticResource UiFont}"
    Foreground="{StaticResource InkBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Shturmap.App.Controls"
    xmlns:session="using:Shturmap.Session"
    xmlns:local="using:Shturmap.App">

  <!-- A key or an item: what it is, where to get it, which of your active quests need it. Point at a source's
       loose spots to see them on the map; point at a quest for its card. -->
  <Border x:Name="Frame" Width="340" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
    <!-- An item many quests need makes a long card: it scrolls inside the room there is, like the quest card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">

      <StackPanel Padding="14,14,14,14" Spacing="8">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Picture ItemId="{x:Bind View.ItemId}" Glyph="{x:Bind Glyph(View.IsKey)}" Size="60" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind View.Name}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{x:Bind KindText(View.IsKey)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Grid>

        <StackPanel Visibility="{x:Bind Shown(View.Get.Count)}">
          <TextBlock Style="{StaticResource EyebrowText}" Text="GET IT" Margin="0,8,0,4" />
          <ItemsControl ItemsSource="{x:Bind View.Get}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="session:ItemSource">
                <Grid ColumnSpacing="10" Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:Picture TraderId="{x:Bind TraderId}" Glyph="{x:Bind controls:ItemCard.SourceGlyph(Kind)}" Size="20"
                                    Visibility="{x:Bind controls:ItemCard.ShownIfTrader(TraderId)}" />
                  <FontIcon Glyph="{x:Bind controls:ItemCard.SourceGlyph(Kind)}" FontSize="14" Foreground="{StaticResource MutedBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{x:Bind controls:ItemCard.ShownIfNoTrader(TraderId)}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Visibility="{x:Bind Shown(View.Uses.Count)}">
          <TextBlock Style="{StaticResource EyebrowText}" Text="NEEDED FOR" Margin="0,8,0,4" />
          <ItemsControl ItemsSource="{x:Bind View.Uses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="session:ItemUse">
                <Grid ColumnSpacing="10" Margin="-6,0" Padding="6,4" controls:Linked.Quest="{x:Bind QuestId}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:KindGlyph Kind="{x:Bind QuestKind}" Brush="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind QuestName}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind How}" Style="{StaticResource NoteText}" />
                  </StackPanel>
                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Size="20" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="None of your active quests needs it." Style="{StaticResource NoteText}" Visibility="{x:Bind Hidden(View.Uses.Count)}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
