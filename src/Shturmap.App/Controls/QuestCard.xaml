<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Shturmap.App.Controls.QuestCard"
    FontFamily="{StaticResource UiFont}"
    Foreground="{StaticResource InkBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Shturmap.App.Controls"
    xmlns:session="using:Shturmap.Session"
    xmlns:local="using:Shturmap.App">

  <!-- One card per quest: who gives it, what to do and where, what to bring, why Shturmap thinks it's active.
       Keys, items and quests on it are cards of their own: point at them. -->
  <Border x:Name="Frame" Width="360" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1" CornerRadius="0">
    <!-- A long quest's card (Collector) is taller than the window: the card takes the room there is (CardStack and
         QuestWindow give it its largest height) and scrolls inside, so UNLOCKS and the wiki link stay in reach. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">

      <StackPanel Padding="14,12,14,12" Spacing="10">
        <Grid ColumnSpacing="12" controls:Linked.Also="{x:Bind View.QuestIds}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:Picture TraderId="{x:Bind View.TraderId}" Size="44" />
          <StackPanel Grid.Column="1" Spacing="2">
            <Grid ColumnSpacing="7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:KindGlyph Kind="{x:Bind View.Kind}" Brush="{StaticResource AmberBrush}" Margin="0,3,0,0" />
              <TextBlock Grid.Column="1" Text="{x:Bind View.Name}" Style="{StaticResource TitleText}" />
            </Grid>
            <TextBlock Text="{x:Bind View.Facts}" Style="{StaticResource NoteText}" />
            <TextBlock Text="{x:Bind local:Caps.Of(View.Status)}" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource GreenBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
          <!-- Two different things: pick the quest for the coming raid (the pen), keep this card as a window (pop out). -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
            <controls:KeepToggle QuestId="{x:Bind View.QuestId}" Framed="True" />
            <Button x:Name="PinButton" Padding="7,5" VerticalAlignment="Top" Click="OnPinClick"
                    ToolTipService.ToolTip="Pop out: keep this card open as a small window you can place anywhere">
              <FontIcon x:Name="PinGlyph" FontSize="14" />
            </Button>
          </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{x:Bind View.Objectives}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="session:CardObjective">
              <!-- The row is its objective for the linked highlight: pointing at it marks the objective within the
                   quest (only its places pulse on the map), and it lights up when one of those places is pointed at. -->
              <Grid ColumnSpacing="10" Margin="-4,1" Padding="4,3"
                    controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Also="{x:Bind QuestIds}" controls:Linked.Objective="{x:Bind ObjectiveId}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- An objective the player ticked as done is muted, as done objectives are on the map, and says where
                     "done" comes from in the place of its distance (owner, 2026-10-04). -->
                <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{x:Bind controls:QuestCard.GlyphBrush(Done)}" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Foreground="{x:Bind controls:QuestCard.TextBrush(Done)}" />
                  <TextBlock Text="{x:Bind Where}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                             Visibility="{x:Bind controls:QuestCard.ShownIf(Where)}" />
                  <TextBlock Text="{x:Bind Live}" Style="{StaticResource StatusText}" FontSize="12" Foreground="{StaticResource AmberBrush}"
                             Visibility="{x:Bind controls:QuestCard.ShownIf(Live)}" />
                  <TextBlock Text="{x:Bind Ticked}" Style="{StaticResource StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                             Visibility="{x:Bind controls:QuestCard.ShownIf(Ticked)}" />
                </StackPanel>
                <controls:Picture Grid.Column="2" ItemId="{x:Bind ItemId}" Size="30" Visibility="{x:Bind controls:QuestCard.ShownIf(ItemId)}" />
                <!-- The one thing the player may tell Shturmap about progress: this objective is done. Never asked for. -->
                <controls:TickBox Grid.Column="3" ObjectiveId="{x:Bind ObjectiveId}" Ticked="{x:Bind Done}"
                                  Visibility="{x:Bind controls:QuestCard.ShownIfTrue(Tickable)}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{x:Bind ShownIfAny(View.Needs)}">
          <TextBlock Style="{StaticResource EyebrowText}" Text="BRING" Margin="0,2,0,4" />
          <ItemsControl ItemsSource="{x:Bind View.Needs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="session:CardNeed">
                <Grid ColumnSpacing="10" Margin="-4,1" Padding="4,3"
                      controls:Linked.Item="{x:Bind ItemId}" controls:Linked.Also="{x:Bind QuestIds}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:Picture ItemId="{x:Bind ItemId}" Size="34" Glyph="{x:Bind controls:QuestCard.NeedGlyph(Kind)}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Where}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind controls:QuestCard.ShownIf(Where)}" />
                    <TextBlock Text="{x:Bind Source}" Foreground="{StaticResource AmberBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind controls:QuestCard.ShownIf(Source)}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Visibility="{x:Bind ShownIfAny(View.Unlocks)}">
          <TextBlock Style="{StaticResource EyebrowText}" Text="UNLOCKS" Margin="0,2,0,4" />
          <ItemsControl ItemsSource="{x:Bind View.Unlocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="session:CardQuest">
                <Grid ColumnSpacing="8" Margin="-4,0" Padding="4,2" controls:Linked.Quest="{x:Bind QuestId}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:KindGlyph Kind="{x:Bind Kind}" Brush="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                  <controls:Picture Grid.Column="2" TraderId="{x:Bind TraderId}" Size="18" Opacity="0.7" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Bind View.UnlocksMore}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="22,2,0,0"
                     Visibility="{x:Bind Shown(View.UnlocksMore)}" />
        </StackPanel>

        <!-- A link that leaves Shturmap, in the look of the others (WIKI MAP ↗, LOG FOLDER ↗): capitals and the arrow. -->
        <HyperlinkButton NavigateUri="{x:Bind WikiUri(View.WikiLink)}" Click="OnWikiClick" Padding="0"
                         Visibility="{x:Bind Shown(View.WikiLink)}"
                         ToolTipService.ToolTip="Opens this quest's page on the Escape from Tarkov wiki in your browser">
          <TextBlock Text="WIKI PAGE ↗" Style="{StaticResource StatusText}" FontSize="11" Foreground="{StaticResource AmberBrush}" />
        </HyperlinkButton>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
