<Project Sdk="Microsoft.NET.Sdk">
  <!-- Public game data (json.tarkov.dev, tarkov.dev map definitions and artwork), cached on disk. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spotter.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Trader portraits and item icons arrive as WebP; they are stored as PNG so any image control can show them. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spotter.Core\Spotter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spotter.Data.Tests" />
  </ItemGroup>
</Project>
